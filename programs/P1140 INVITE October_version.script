      if (lm.capture_relation == "front_left"):
          return CAM_Capture_Poses.front_left
      elif (lm.capture_relation == "left"):
          return CAM_Capture_Poses.left
      elif (lm.capture_relation == "back_left"):
          return CAM_Capture_Poses.back_left
      elif (lm.capture_relation == "back_right"):
          return CAM_Capture_Poses.back_right
      elif (lm.capture_relation == "right"):
          return CAM_Capture_Poses.right
      elif (lm.capture_relation == "straight_left"):
         return CAM_Capture_Poses.straight_left
      else:
          # error
          return get_actual_tcp_pose()
      end
  end
