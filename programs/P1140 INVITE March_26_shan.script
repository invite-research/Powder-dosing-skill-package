  global g_has_ref = False
  global g_pivot_pose = p[0, 0, 0, 0, 0, 0]
  global g_rel0 = p[0, 0, 0, 0, 0, 0]
  global g_current_angle = 0.0
  
  hinge_offset = p[0, 0, -0.20, 0, 0, 0] #n wut?
  global g_rq_ready = False
