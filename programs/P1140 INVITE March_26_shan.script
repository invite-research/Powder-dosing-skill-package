  def Sub_AMR_MiR_V3():
    $ 1210 "Sub_AMR_MiR_V3" "noBreak"
    $ 1211 "PreSettings"
    $ 1212 "AMR_TargetList≔[1,2,3,4,5,21,22,23,24,31,32,33,34,35,36,37,38,41]"
    global AMR_TargetList=[1,2,3,4,5,21,22,23,24,31,32,33,34,35,36,37,38,41]
