    global AMR_PosActual=modbus_get_signal_status("T2O_Current_Pos")
    $ 1215 "AMR_Attemps≔T2O_Nav_Attemps"
    global AMR_Attemps=modbus_get_signal_status("T2O_Nav_Attemps")
    $ 1216 "AMR_Battery≔MiR_Battery_Lvl"
    global AMR_Battery=modbus_get_signal_status("MiR_Battery_Lvl")
    $ 1217 "AMR_Charging≔(T2O_Charging≟1)"
    global AMR_Charging=(modbus_get_signal_status("T2O_Charging") == 1)
    $ 1218 "AMR_Position≔struct(position_identifier=T2O_Current_Pos, x1=MiR_Position_X1, x2=MiR_Position_X2, y1=MiR_Position_Y1, y2=MiR_Position_Y2, theta1=MiR_Theta_1, theta2=MiR_Theta_2) "
    global AMR_Position=struct(position_identifier=modbus_get_signal_status("T2O_Current_Pos"), x1=modbus_get_signal_status("MiR_Position_X1"), x2=modbus_get_signal_status("MiR_Position_X2"), y1=modbus_get_signal_status("MiR_Position_Y1"), y2=modbus_get_signal_status("MiR_Position_Y2"), theta1=modbus_get_signal_status("MiR_Theta_1"), theta2=modbus_get_signal_status("MiR_Theta_2")) 
    $ 1219 "If MiR_Mode≠7"
    if (modbus_get_signal_status("MiR_Mode") != 7):
      $ 1220 "Error"
      $ 1221 "set_error(ERROR_AMR_WRONG_MODE)"
      set_error(ERROR_AMR_WRONG_MODE)
      $ 1222 "AMR_Done≔ True "
      global AMR_Done=  True  
    end
    $ 1223 "'=========='"
    # '=========='
    $ 1224 "Switch STATE"
    switch_1 = STATE
    $ 1225 "Case 1"
    if (1 == switch_1):
      $ 1226 "stopping"
      $ 1227 "If T2O_Done≟1 and O2T_Acknowledge≟0"
      if (modbus_get_signal_status("T2O_Done") == 1  and  modbus_get_signal_status("O2T_Acknowledge") == 0):
        $ 1228 "Set O2T_Acknowledge=1"
        modbus_set_output_register("O2T_Acknowledge", 1)
      end
      $ 1229 "Set MiR_CMD_Stop=On"
      modbus_set_output_signal("MiR_CMD_Stop", True)
      $ 1230 "AMR_Position.position_identifier = 0"
      AMR_Position.position_identifier = 0
      $ 1231 "AMR_Done≔ True "
      global AMR_Done=  True  
    elif (2 == switch_1):
      $ 1232 "Case 2"
      $ 1233 "stopped"
      $ 1234 "If MiR_State≠3 and MiR_State≠5"
      if (modbus_get_signal_status("MiR_State") != 3  and  modbus_get_signal_status("MiR_State") != 5):
        $ 1235 "Set MiR_CMD_Stop=Off"
        modbus_set_output_signal("MiR_CMD_Stop", False)
      end
    elif (3 == switch_1):
      $ 1236 "Case 3"
      $ 1237 "resetting"
      $ 1238 "Set O2T_Mis_Main=Off"
      modbus_set_output_signal("O2T_Mis_Main", False)
      $ 1239 "Set O2T_Mis_Charge=Off"
      modbus_set_output_signal("O2T_Mis_Charge", False)
      $ 1240 "If MiR_Mis_Queue>0"
      if (modbus_get_signal_status("MiR_Mis_Queue")>0):
        $ 1241 "Set MiR_CMD_Clear_Q=On"
        modbus_set_output_signal("MiR_CMD_Clear_Q", True)
        $ 1242 "Wait MiR_Mis_Queue≟0"
        while (not(modbus_get_signal_status("MiR_Mis_Queue") == 0)):
