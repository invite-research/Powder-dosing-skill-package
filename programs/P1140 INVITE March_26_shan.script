  def tilt_init_reference():
  	p_center = get_actual_tcp_pose()
  	g_pivot_pose = pose_trans(p_center, hinge_offset)
  	g_rel0 = pose_trans(pose_inv(g_pivot_pose), p_center)
  	g_current_angle = 0.0
  	g_has_ref = True
  end
  
  def rq_ensure_ready():
  	if (not g_rq_ready):
  		rq_activate_and_wait()
  		rq_set_force(RQ_FORCE)
  		rq_set_speed(RQ_SPEED)
  		g_rq_ready = True
  	end
  end
  
  
  
  #def rq_open_and_wait():
  	#rq_open()
  	#sleep(0.25)
  #end
  
  def tilt_to(target_deg):
  	if ( not g_has_ref):
  		tilt_init_reference()
  	end
  
  	rq_ensure_ready()
  	rq_close_and_wait()
  
  	angle_mid = (g_current_angle + target_deg)/2.0
  	rad_mid = (angle_mid)*3.1416/180
  	rad_end = target_deg*3.1416/180
  
  	tilt_mid = p[0,0,0, -rad_mid, 0, 0]
  	tilt_end = p[0,0,0, -rad_end, 0, 0]
  
  	pose_rel_mid = pose_trans(tilt_mid, g_rel0)
  	pose_rel_end = pose_trans(tilt_end, g_rel0)
  
  	via_pose = pose_trans(g_pivot_pose, pose_rel_mid)
  	end_pose = pose_trans(g_pivot_pose, pose_rel_end)
  
  	movec(via_pose, end_pose, a=0.05, v=0.01, r=0.001)
  
  	rq_open_and_wait()
  
  	g_current_angle = target_deg
  end
  
  
  def tilt_by(delta_deg):
  	tilt_to(g_current_angle + delta_deg)
  end
  
  def tilt_reset():
  	g_has_ref = False
  end
