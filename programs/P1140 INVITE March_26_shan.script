  # ============================================
  # Recipe Dosing URScript (3 powders, sorted A/B/C)
  # - keeps final mixture ratio after 1st overshoot
  # - syncs with Python dashboard via TCP
  # ============================================
  
  # --------- HANDOFF GLOBALS (used by other skills) ---------
  global Pow_name = ""
  global target_weight = 0.0
  global last_dose_error = 0.0
  
  # --------- RECIPE STATE ---------
  global powder_names = ["", "", ""]
  global powder_ratios = [0.0, 0.0, 0.0]      # fractions 0..1
  global powder_targets = [0.0, 0.0, 0.0]     # target weights for each powder
  global powder_actuals = [0.0, 0.0, 0.0]     # measured after dosing
  global powder_order  = [0, 1, 2]            # indices, sorted by ascending ratio
  
  global total_weight = 0.0                   # initial / adjusted total
  global current_powder_index = 0             # index into powder_order
  global ratio_adjusted = False               # did we already adjust after powder 1
  global dose_start_weight = 0.0              # weight at dosing start for each powder
  
  # --------- FINAL RESULTS (for dashboard) ---------
  # WA/WB/WC = final weights of powders A/B/C after dosing (sorted by ratio)
  global WA = 0.0
  global WB = 0.0
  global WC = 0.0
  
  # finalPercA/B/C = final percentages of WA/WB/WC wrt adjusted total
  global finalPercA = 0.0
  global finalPercB = 0.0
  global finalPercC = 0.0
  
  # counter to know which powder we just finished (1 → A, 2 → B, 3 → C)
  global dose_counter = 0
  
  
  # =====================================================
  # SORTING HELPERS (BY ASCENDING RATIO)
  # =====================================================
  
  def swap_order(i, j):
    local temp = powder_order[i]
    powder_order[i] = powder_order[j]
    powder_order[j] = temp
  end
  
  def sort_powders_by_ratio():
    # bubble-sort style, only 3 elements
    global powder_order = [0, 1, 2]
  
    if (powder_ratios[powder_order[1]] < powder_ratios[powder_order[0]]):
      swap_order(0, 1)
    end
  
    if (powder_ratios[powder_order[2]] < powder_ratios[powder_order[1]]):
      swap_order(1, 2)
    end
  
    if (powder_ratios[powder_order[1]] < powder_ratios[powder_order[0]]):
      swap_order(0, 1)
    end
  end
  
  
  # =====================================================
  # TCP SENDING HELPERS (Python dashboard @ 192.168.12.103:3002)
  # =====================================================
  
  # Send powder labels in sorted A/B/C order
  # A = least %, B = middle %, C = highest %
  def send_powder_labels():
    local A = powder_names[powder_order[0]]
    local B = powder_names[powder_order[1]]
    local C = powder_names[powder_order[2]]
  
    socket_open("192.168.12.103", 3002)
    local cmd = "SET_LABELS:" + A + ";" + B + ";" + C
    textmsg("Sending labels: ", cmd)
    socket_send_string(cmd)
    sleep(0.2)
    socket_close()
  end
  
  # Send initial recipe (TOTAL;PA;PB;PC) in sorted order
  # powder_ratios are fractions (0..1), we convert to %
  def send_init_recipe(total_w):
    local rA = powder_ratios[powder_order[0]] * 100
    local rB = powder_ratios[powder_order[1]] * 100
    local rC = powder_ratios[powder_order[2]] * 100
  
    socket_open("192.168.12.103", 3002)
    local cmd = "SET_INIT:" +
                to_str(total_w) + ";" +
                to_str(rA) + ";" +
                to_str(rB) + ";" +
                to_str(rC)
    textmsg("Sending INIT: ", cmd)
    socket_send_string(cmd)
    sleep(0.2)
    socket_close()
  end
  
  # Send final recipe:
  # SET_FINAL:ADJ_TOTAL;PA;PB;PC;WA;WB;WC
  # where PA/B/C = finalPercA/B/C, WA/B/C = final weights, adj_total = total_weight
  def send_final_recipe(adj_total):
    socket_open("192.168.12.103", 3002)
  
    local cmd = "SET_FINAL:" +
                to_str(adj_total) + ";" +
                to_str(finalPercA) + ";" +
                to_str(finalPercB) + ";" +
                to_str(finalPercC) + ";" +
                to_str(WA) + ";" +
                to_str(WB) + ";" +
                to_str(WC)
    textmsg("Sending FINAL: ", cmd)
    socket_send_string(cmd)
    sleep(0.2)
    socket_close()
  end
  
  
  # =====================================================
  # FINAL WEIGHT & PERCENTAGE LOGIC
  # =====================================================
  
  # Call this ONCE after each powder dosing is finished
  # final_weight = w_dosed_total of the just-finished powder
  def record_final_weight_for_current_powder(final_weight):
    dose_counter = dose_counter + 1
  
    if dose_counter == 1:
      WA = final_weight
      textmsg("Assigned WA (Powder A): ", WA)
    elif dose_counter == 2:
      WB = final_weight
      textmsg("Assigned WB (Powder B): ", WB)
    elif dose_counter == 3:
      WC = final_weight
      textmsg("Assigned WC (Powder C): ", WC)
    else:
      textmsg("WARNING: dose_counter > 3, ignoring extra weight")
    end
  end
  
  # Compute final percentages from WA/WB/WC and adjusted total
  def compute_final_percentages(adj_total):
    if adj_total <= 0:
      textmsg("ERROR: adj_total <= 0, cannot compute final %")
    else:
      finalPercA = WA / adj_total * 100
      finalPercB = WB / adj_total * 100
      finalPercC = WC / adj_total * 100
      textmsg("Final % A/B/C: ", finalPercA, finalPercB, finalPercC)
    end
  end
  
  
  # =====================================================
  # RECIPE INITIALIZATION
  # =====================================================
  
  # powA/B/C  : strings (e.g. "MCC", "CCS", "MAGNESIUM_STEARATE")
  # total     : initial total weight (g)
  # ratioA/B/C: fractions (0..1), e.g. 0.3, 0.2, 0.5
  def recipe_init(powA, powB, powC, total, ratioA, ratioB, ratioC):
    global powder_names  = [powA, powB, powC]
    global powder_ratios = [ratioA, ratioB, ratioC]
    global total_weight  = total
  
    global powder_targets = [total*ratioA, total*ratioB, total*ratioC]
    global powder_actuals = [0.0, 0.0, 0.0]
  
    global current_powder_index = 0
    global ratio_adjusted = False
    global dose_start_weight = 0.0
  
    dose_counter = 0
    WA = 0.0
    WB = 0.0
    WC = 0.0
  
    sort_powders_by_ratio()
  
    # NOTE: you call these from your main flow when you want:
    send_powder_labels()
    send_init_recipe(total)
  end
  
  
  # =====================================================
  # POSITION + CAMERA HELPERS (YOUR EXISTING LOGIC)
  # =====================================================
  
  def get_position_for_powder(Pow_name):
    if pos1_powder == Pow_name:
      return "Position1"
    elif pos2_powder == Pow_name:
      return "Position2"
    elif pos3_powder == Pow_name:
      return "Position3"
    else:
      return -1
    end
  end
  
  def extract_powder_name(raw_str):
    local idx_open  = str_find(raw_str, "(")
    local idx_close = str_find(raw_str, ")")
  
    if (idx_open < 0) or (idx_close < 0):
      return raw_str
    end
  
    local inside = ""
    local i = idx_open + 1
    while i < idx_close:
      inside = str_cat(inside, str_at(raw_str, i))
      i = i + 1
    end
  
    local idx_comma = str_find(inside, ",")
    if idx_comma < 0:
      return inside
    end
  
    local powder = ""
    local j = idx_comma + 1
    while j < str_len(inside):
      powder = str_cat(powder, str_at(inside, j))
      j = j + 1
    end
  
    return powder
  end
  
  def get_response_from_camera(target):
    movel(target, a=0.1, v=0.12, r=0)
    visor_trigger("1", "3.0", "arm")
    global response = visor_getResponse(1)
  end
  
  
  # =====================================================
  # RECIPE STEP SELECTION
  # =====================================================
  
  # Call recipe_next() before each dosing run.
  # Returns True if a powder exists, False if done.
  def recipe_next():
    if (current_powder_index >= 3):
      return False
    end
  
    local i = powder_order[current_powder_index]
    global Pow_name = powder_names[i]
    global target_weight = powder_targets[i]
  
    global powder_position = get_position_for_powder(Pow_name)
  
    if (Pow_name == "CCS"):
      W_now = 200.0
    elif (Pow_name == "MCC"):
      W_now = 131.0
    else:
      W_now = 100.0
    end
  
    return True
  end
  
  
  # =====================================================
  # DOSING START / END
  # =====================================================
  
  # Call at the beginning of each powder dosing run
  def dosing_start():
    global dose_start_weight = get_weight()
    global switch_spat_M = True
    global switch_spat_S = True
    global switch_spat_F_S = True
  end
  
  # Call after dosing is finished for current powder
  def dosing_end():
    local idx = powder_order[current_powder_index]
    local weight_after = get_weight()
    local actual_weight = weight_after - dose_start_weight
  
    # store actual weight
    local tmp = powder_actuals
    tmp[idx] = actual_weight
    global powder_actuals = tmp
  
    # save error
    global last_dose_error = actual_weight - powder_targets[idx]
  
    # store WA/WB/WC in dosing (sorted) order
    record_final_weight_for_current_powder(actual_weight)
  
    # one-time correction after first powder (ratio preserving)
    if ((current_powder_index == 0) and (not ratio_adjusted)):
      local j = powder_order[1]
      local k = powder_order[2]
  
      local ratio_first = powder_ratios[idx]
      if (ratio_first > 0.0):
        # new_total = actual / ratio_first
        local new_total = actual_weight / ratio_first
        if (new_total < 0.0):
          new_total = 0.0
        end
  
        local ttmp = powder_targets
        ttmp[idx] = actual_weight
        ttmp[j]   = new_total * powder_ratios[j]
        ttmp[k]   = new_total * powder_ratios[k]
        global powder_targets = ttmp
  
        global adj_total = new_total
      end
  
      global ratio_adjusted = True
    end
  
    global current_powder_index = current_powder_index + 1
  end
  $ 22 "Script: scooping_s2.script"
  def scooping_init():
  	global diameter=0.068 #neck inner qr
  	global container_height = 0.149
  	global neckandcontainer_height = 0.029 # qr input
  	global hinge_height = 0.016
  	global cube_length = 0.0666 #qr input
  	global bottle_diameter = 0.07 # qr input
  	global container_id = 1 # qr input
  
  	global angle_min = 18.0
  	global angle_max = 68.0
  	global gain_per_percent = 0.5
  
  	global level = 0.0
  	global tilt_angle_sent = 0.0
  	global w_dosed_total = 0.0
  	global last_scale = 0.0
  
  	# heigth of the container
  	global g_z0_hi = hinge_height #n prev: 0.016
  	#global g_z100_hi = 0.0942 #n 129.5-33.3+hinge= 96.2+5.5 = 101.7
  	global g_z100_hi = container_height-neckandcontainer_height
  
  	# limits of container height
  	global g_z_min = 0.0186
  	global g_z_max = 0.25
  
  	global g_corr_max = 0.010
  	global g_prev_cum_w = -1.0
  	global g_depth_corr = 0.0
  	global spatula_len = 0.17
  	#global target_g = 0.0 #trying to remove this and make the code work
  
  	# error handling params
  	global scoop_ct = 0
  	global error_sum = 0.0
  	global error_sq_sum = 0.0
  	global scoop_g = 0.0
  
  	# Each chemicals property for scooping accuracy
  	if (Pow_name=="NaCl"):
  		global W_FULL = 625.00 #d
  		#global W_FULL = 444.10 #n qr input
  		global g_exp = 0.80
  		global g_k = 0.03
  		global g_alpha = 0.7
  	elif (Pow_name == "Mannitol"):
  		global W_FULL = 300.00#n qr input
  		global g_exp = 0.82
  		global g_k = 0.025
  		global g_alpha = 0.6
  	elif (Pow_name == "MCC"):
  		global W_FULL = 280.0#n qr input
  		global g_exp = 0.82
  		global g_k = 0.035
  		global g_alpha = 0.7
  	elif (Pow_name == "CCS"):
  		global W_FULL = 250.0#n qr input
  		global g_exp = 0.82
  		global g_k = 0.035
  		global g_alpha = 0.7
  	elif (Pow_name == "Magnesium_stearate"):
  		global W_FULL = 200.0#n qr input
  		global g_exp = 0.84
  		global g_k = 0.025
  		global g_alpha = 0.6
  	elif (Pow_name == "lactose_fine"):
  		global W_FULL = 330.0#n qr input
  		global g_exp = 0.84
  		global g_k = 0.025
  		global g_alpha = 0.55
  	else:
  		popup("Unkwon powder type. Using default NaCl settings.", title="Calibration Warning")
  		global W_FULL = 300.0#n qr input
  		global g_k = 0.03
  		global g_alpha = 0.7
  	end
  end
  
  # clamping values level them into 0-100
  def clamp(x, lo, hi):
  	if(x<lo):
  		return lo
  	elif (x>hi):
  		return hi
  	else:
  		return x
  	end
  end
  
  def compute_level_percent(W_now, weight_value):
  
  	local delta = weight_value - last_scale
  	if (delta<0.0):
  		delta = 0.0
  	end
  
  	global w_dosed_total = w_dosed_total + delta
  	last_scale = weight_value
  
  	local W_eff = W_now-w_dosed_total
  	if (W_eff<W_EMPTY):
  		W_eff = W_EMPTY
  	end
  
  	# Compute powder level %
  	level = 100.0* (W_eff -W_EMPTY)/ (W_FULL-W_EMPTY)
  
  	# Clamp to 0–100
  	level = clamp(level,0.0,100.0)
  
  	return level
  end
  
  # How much should the POTS tilt
  def compute_tilt_deg(level_percent):
  	angle = angle_min + gain_per_percent*(100.0-level_percent)
  	return clamp(angle, angle_min, angle_max)
  end
  
  # do the tilt based on level
  def tilt(level_percentage):
  	new_angle = compute_tilt_deg(level_percentage)
  	global angle_rel = new_angle - tilt_angle_sent
  
  	if my_abs(angle_rel)>2.0:
  		tilt_send(new_angle)
  		global angle_deg = new_angle
  		global tilt_angle_sent = new_angle
  		global p_center = updated_center_pose(p_center_vertical, angle_deg)
  	end
  
  	if (level<85.0):
  		tilt_send(angle_deg)
  	end
  end
  
  # how deep the spatula should enter
  def compute_scoop_depth(level, cum_w, target_g):
  	if (level >=10.0):
  		ratio = level/100.0
  		corrected = pow(ratio, g_exp)
  		base_z = g_z0_hi + (g_z100_hi - g_z0_hi)*corrected
  
  	elif (level<10.00 and level>=1.00):
  		z0 = 0.023
  		z100 = 0.140
  		ratio2 = level/100.0
  		base_z = z0 +(z100-z0)*ratio2
  	else:
  		base_z = 0.042 #check it should be approx 5.5
  	end
  
  	if (g_prev_cum_w<0):
  		g_prev_cum_w = cum_w
  
  	else:
  		global scoop_g = cum_w-g_prev_cum_w
  		g_prev_cum_w = cum_w
  
  		e = target_g -scoop_g
  
  		corr_proposed = g_k*e
  		g_depth_corr = (1.0 -g_alpha)*g_depth_corr + g_alpha*corr_proposed
  		g_depth_corr = clamp(g_depth_corr, -g_corr_max, g_corr_max)
  	end
  
  	z_tip = base_z - g_depth_corr
  	z_tip = clamp(z_tip, g_z_min, g_z_max)
  
  	return z_tip
  end
  
  # always return absolute value
  def my_abs(val):
  	if (val<0):
  		return -val
  	else:
  		return val
  	end
  end
  
  
  def select_spatula(Pow_name, level, diff, diameter):
  
  	# -----------------------------
  	# Diameter-based spatula cap
  	# -----------------------------
  	global max_spatula = "spatula_L"
  
  	if diameter < 0.06:
  		max_spatula = "spatula_M"
  	end
  
  
  	# -----------------------------
  	# Powder + process logic
  	# -----------------------------
  	if (Pow_name == "lactose_fine" or Pow_name == "Magnesium_sterate"):
  		if (level > 10.0):
  			spatula = "spatula_flat_M"
  		else:
  			spatula = "spatula_flat_S"
  		end
  
  	elif (Pow_name == "NaCl" and level > 10.0 and diff > 6.5):
  		spatula = "spatula_L"
  	elif (Pow_name == "NaCl" and level > 10.0 and diff <= 6.5):
  		spatula = "spatula_M"
  
  	elif (Pow_name == "MCC" and level > 10.0 and diff > 2.0):
  		spatula = "spatula_L"
  	elif (Pow_name == "MCC" and level > 10.0 and diff <= 2.0):
  		spatula = "spatula_M"
  
  	elif ((Pow_name == "Mannitol" or Pow_name == "CCS") and level > 10.0 and diff > 3.2):
  		spatula = "spatula_L"
  	elif ((Pow_name == "Mannitol" or Pow_name == "CCS") and level > 10.0 and diff <= 3.2):
  		spatula = "spatula_M"
  
  	elif (level > 1.0 and level <= 10.0):
  		spatula = "spatula_M"
  	else:
  		spatula = "spatula_S"
  	end
  
  
  	# -----------------------------
  	# Enforce diameter constraint
  	# -----------------------------
  	if (max_spatula == "spatula_M" and spatula == "spatula_L"):
  		spatula = "spatula_M"
  	end
  
  	# Final safeguard: small diameter + low level → S
  	if (diameter < 0.6 and level <= 1.0):
  		spatula = "spatula_S"
  	end
  
  	return spatula
  end
  
  # look up table to identify per scoop quantity
  global target_g_table = [
  	"NaCl", "spatula_L", "6.8",
  	"NaCl", "spatula_M", "1.75",
  	"NaCl", "spatula_S", "0.135",
  
  	"Mannitol", "spatula_L", "3.1",
  	"Mannitol", "spatula_M", "0.9",
  	"Mannitol", "spatula_S", "0.075",
  
  	"CCS", "spatula_L", "2.5",
  	"CCS", "spatula_M", "0.9",
  	"CCS", "spatula_S", "0.075",
  
  	"MCC", "spatula_L", "1.8",
  	"MCC", "spatula_M", "0.5",
  	"MCC", "spatula_S", "0.05",
  
  	"Magnesium_stearate", "spatula_flat_M", "0.5",
  	"Magnesium_stearate", "spatula_flat_S", "0.25",
  
  	"lactose_fine", "spatula_flat_M", "1.0",
  	"lactose_fine", "spatula_flat_S", "0.7"]
  
  # extract above info in a weird way needs to be done in server
  def get_target_g(Pow_name, spat_name):
  	local i = 0
  	local n = length(target_g_table)
  	while (i < n):
  		if (target_g_table[i] == Pow_name and target_g_table[i+1] == spat_name):
  			return to_num(target_g_table[i+2])
  		end
  		i = i+3
  	end
  	popup("No target_g match for: ", Pow_name, ", ", spatula)
  
  end
  
  # main task while dosing, refers to all the task
  def auto_tilt_and_scoop(W_now, target_weight, weight_value):
  	level = compute_level_percent(W_now, weight_value)
  
  	global spatula = select_spatula(Pow_name, level, diff,diameter)
  	global target_g = get_target_g(Pow_name, spatula)
  
  	global scoop_depth = compute_scoop_depth(level, weight_value, target_g)
  
  	tilt(level)
  	#p_center = get_actual_tcp_pose()
  
  	if (scoop_ct < 5 and g_prev_cum_w>0.0):
  		#local scoop_g = scoop_g
  		local error = target_g - scoop_g
  		error_sum = error_sum + error
  		error_sq_sum = error_sq_sum + error*error
  		scoop_ct = scoop_ct+1
  
  		if (scoop_ct==5):
  			local avg_error = error_sum/5.0
  			#local std_dev = sqrt(error_sq_sum/5.0) - (avg_error*avg_error))
  
  			if (my_abs(avg_error)>1.0):
  				g_k = 0.055
  				g_alpha = 0.85
  			elif (my_abs(avg_error)>0.6):
  				g_k= 0.045
  				g_alpha =0.75
  			elif (my_abs(avg_error)> 0.3):
  				g_k = 0.035
  				g_alpha = 0.65
  			elif (my_abs(avg_error)>0.1):
  				g_k = 0.025
  				g_alpha = 0.55
  			else:
  				g_k = 0.015
  				g_alpha = 0.45
  			end
  		end
  	end
  
  	scoop_powder(p_center)
  end
  
  # once scooping is done return to home
  def after_scoop():
  	tilt_send(angle_deg)
  	sleep(0.5)
  	movel(lifted_pose, a=0.05, v=0.2)
  	movel(tilted_pose_in_base, a=0.05, v=0.2)
  	set_analog_out(0,0.4)
  	movel(pose_trans(tilted_pose_in_base, p[-0.01,0,0,0,0,2.0]), a=0.05, v=0.2)
  	set_analog_out(0,0.0)
  	movel(lifted_pose, a=0.05, v=0.2)
  	tilt_to_home()
  end
  $ 24 "Script: dosing_s2.script"
  # vibration motor commands
  def vibration_2():
  	set_analog_out(0,0.4)
  	sleep(0.8)
  	set_analog_out(0,0.0)
  	sleep(0.2)
  end
  
  def vibration_3():
  	set_analog_out(0,0.4)
  	sleep(0.5)
  	set_analog_out(0,0.0)
  	sleep(0.3)
  end
  
  def vibration_4():
  	set_analog_out(0,0.4)
  	sleep(0.6)
  	set_analog_out(0, 0.0)
  	sleep(0.5)
  end
  
  def vibration_1():
  	set_analog_out(0,0.4)
  	sleep(1)
  	set_analog_out(0,0.0)
  	sleep(0)
  end
  
  # steps
  def move_tilt_in_steps(Pow_center, final_pose, steps):
  	i = 0
  	while i <= steps:
  		ratio = i / steps
  		pose_step = p[Pow_center[0] + ratio * (final_pose[0] - Pow_center[0]), Pow_center[1] + ratio * (final_pose[1] -Pow_center[1]),Pow_center[2] + ratio * (final_pose[2] - Pow_center[2]), Pow_center[3] + ratio * (final_pose[3] - Pow_center[3]), Pow_center[4] + ratio * (final_pose[4] - Pow_center[4]), Pow_center[5] + ratio * (final_pose[5] - Pow_center[5])]
  		movej(pose_step, a=1.2, v=0.15)
  		sleep(0.1)
  		i = i+1
  	end
  end
  
  # tilt the container based on pose of container entry point
  def tilt_container(angle):
  	global p_center = get_actual_tcp_pose()
  	hinge_offset = p[0,0,- hinge_height-container_height-0.065,0,0,0]# this should be container height+hinge distance from tcp-tip to base of hinge. check?
  	pivot_pose = pose_trans(p_center, hinge_offset)
  	pose_rel = pose_trans(pose_inv(pivot_pose), p_center)
  	angle_mid = (angle/2.0)*3.1416/180
  	angle_end = angle*3.1416/180
  	tilt_mid = p[0,0,0, -angle_mid, 0, 0]
  	tilt_end = p[0,0,0, -angle_end, 0, 0]
  	pose_rel_mid = pose_trans(tilt_mid, pose_rel)
  	pose_rel_end = pose_trans(tilt_end, pose_rel)
  	via_pose = pose_trans(pivot_pose, pose_rel_mid)
  	end_pose = pose_trans(pivot_pose, pose_rel_end)
  	movec(via_pose, end_pose, a=0.05, v=0.01, r=0.001)
  	p_center = get_actual_tcp_pose()
  end
  
  # convertion of degree to radians
  def deg2rad(d):
  	return d*3.141592/180
  end
  
  # tilt values clamping based on powders
  def map_tilt_to_ry_deg(container_deg):
  	#ry_deg = -0.875*container_deg +87.0
  	#return clamp(ry_deg, 5.0, 80.0)
  	if (Pow_name == "NaCl" or Pow_name == "Mannitol" or Pow_name == "CCS" or Pow_name == "MCC"):
  		if ( level>=10.0):
  			ry_min = 10.0
  			ry_max = 75.0
  		elif (level<10.00 and level >1.00):
  			ry_min = 16.0
  			ry_max = 65.0
  		else:
  			ry_min=17.0
  			ry_max=75.0
  		end
  	else:
  		if ( level>=10.0):
  			ry_min = 0.0
  			ry_max = 65.0
  		elif (level<10.00 and level >1.00):
  			ry_min = 10.0
  			ry_max = 45.0
  		else:
  			ry_min=0.0
  			ry_max=50.0
  		end
  
  	end
  	local span_count = angle_max-angle_min
  	local span_ry = ry_max - ry_min
  
  	local t = (container_deg -angle_min)/span_count
  	local ry_deg = ry_max - t*span_ry
  
  	return clamp(ry_deg, ry_min, ry_max)
  
  end
  
  def caluclate_corrections(level):
  	z_high = 0.01
  	z_low = -0.08
  	y_high = -0.01
  	y_low = -0.015
  
  	scale = (level - 10.0) / (100.0-10.0)
  
  	global correction_z = z_low + scale*(z_high - z_low)
  	global correction_y = y_low + scale*(y_high -y_low)
  
  end
  
  # scoop the powder using all the params
  def scoop_powder(p_center):
  	vibration_voltage = 0.4
  	vibration_time = 3.0
  	global scoop_radius_default = 0.0
  
  	# spatula's scoop max height used here
  	if (spatula == "spatula_L"):
  		global spatula_depth = 0.015
  	elif (spatula == "spatula_M"):
  		global spatula_depth = 0.01
  	elif (spatula == "spatula_S"):
  		global spatula_depth = 0.008
  	elif (spatula == "spatula_flat_M"):
  		global spatula_depth = 0.001
  	elif (spatula == "spatula_flat_S"):
  		global spatula_depth = 0.005
  	end
  
  	# have offset based on level
  	if (level >=70.00):
  		approach_offset = p[0,0,spatula_len+0.05,0,0,0]
  		lift_offset = p[0, 0, 0.05, 0, 0, 0]
  		caluclate_corrections(level)
  	elif (level >=10.00 and level <70):
  		approach_offset = p[0,0,spatula_len+0.05,0,0,0]
  		lift_offset = p[0, 0, 0.15, 0, 0, 0]
  		caluclate_corrections(level)
  	elif (level<10.00 and level >= 1.00):
  		approach_offset = p[0,0,spatula_len+0.05,0,0,0]
  		correction_z = -0.08
  		correction_y = -0.01
  		lift_offset = p[0, 0, 0.14, 0, 0, 0]
  	else:
  		approach_offset = p[0,0,spatula_len+0.05,0,0,0]
  		correction_z = -0.08
  		correction_y = -0.01
  		lift_offset = p[0, 0, 0.14, 0, 0, 0]
   	end
  
  	# local entry_pose  = pose_trans(feature_pose, p[0, 0, entry_distance, 0, 0, 0])
  
  	# move into entry pose (surprisingly away from the hinge&p_center)
  	global scoop_entry_pose = pose_trans(p_center, approach_offset)
  	#popup("adsad", title="Pause",blocking=True)
  	movel(scoop_entry_pose, a=0.1, v=0.25)
  
  	popup("adsad2", title="Pause",blocking=True)
  	#global entry_pose = pose_trans(p_center, p[0,0,0.22,0,0,0])
  	#movel(entry_pose, a=0.5,v=0.3)
  
  	# scoop around radius-spatula depth to get max scooping angle
  	scoop_radius_default = diameter/2 - spatula_depth
  
  	# scoop starting point based on level/scoop depth
  	scoop_start_rel = p[scoop_radius_default, 0, scoop_depth, 0, 0, 0]
  
  	rot_mid = p[0, 0, 0, 0, 0, 0.785]  # 45°
  	rot_end = p[0, 0, 0, 0, 0, 1.5708] # 90°
  
  	scoop_via_rel = pose_trans(rot_mid, scoop_start_rel)
  	scoop_end_rel = pose_trans(rot_end, scoop_start_rel)
  
  	global scoop_start_pose = pose_trans(p_center, scoop_start_rel)
  	scoop_via_pose = pose_trans(p_center, scoop_via_rel)
  	scoop_end_pose = pose_trans(p_center, scoop_end_rel)
  
  	movel(scoop_start_pose, a=0.5, v=0.3)
  
  	if (level<90.0):
  		Rotate()
  	end
  
  	movec(scoop_via_pose, scoop_end_pose, a=0.03, v=0.02)
  	sleep(1.0)
  	local ry_deg = map_tilt_to_ry_deg(angle_deg)
  	local ry = deg2rad(ry_deg)
  	local end_rel = pose_trans(pose_inv(p_center), scoop_end_pose)
  	local end_rel_tilted = pose_trans(end_rel, p[0, 0, 0, 0, ry, 0])
  	global tilted_pose_in_base = pose_trans(p_center, p[0,correction_y,correction_z,end_rel_tilted[3],end_rel_tilted[4], end_rel_tilted[5]])
  	global tilted_pose_in_base = pose_trans(tilted_pose_in_base, p[0, 0, spatula_len, 0, 0, 0])
  
  	if (Pow_name == "lactose_fine" or Pow_name == "Magnesium_sterate"):
  		tilt_send((angle_deg+5))
  	end
  	movel(tilted_pose_in_base, a=0.03, v=0.1)
  
  	if (Pow_name == "lactose_fine" or Pow_name == "Magnesium_sterate"):
  		tilt_send((angle_deg-5))
  	end
  
  	if (spatula=="spatula_flat_S" or spatula=="spatula_S"):
  		vibration_3()
  	else:
  		set_analog_out(0, vibration_voltage)
  	end
  	if (Pow_name=="Mannitol" or Pow_name =="NaCl"):
  		local n=1.4
  	else:
  		local n=1.5
  	end
  	local ry_level = deg2rad(ry_deg/n)
  	local end_rel_tilted_level = pose_trans(end_rel, p[0, 0, 0, 0, ry_level, 0])
  	local level_tilted_pose_in_base = pose_trans(p_center, p[0,correction_y,correction_z,end_rel_tilted_level[3],end_rel_tilted_level[4], end_rel_tilted_level[5]])
  	local level_tilted_pose_in_base = pose_trans(level_tilted_pose_in_base, p[0, 0, spatula_len, 0, 0, 0])
  
  	movel(level_tilted_pose_in_base, a=0.03, v=0.1)
  	#if (level>70.0):
  		#sleep(1.0)
  	#end
  	sleep(1.0)
  	#sleep(vibration_time)
  
  	movel(tilted_pose_in_base, a=0.03, v=0.1)
  	set_analog_out(0, 0.0)
  
  	tilt_pose_rel = pose_trans(pose_inv(p_center), tilted_pose_in_base)
  
  	lifted_pose_rel = pose_trans(lift_offset, tilt_pose_rel)
  
  	global lifted_pose = pose_trans(p_center, lifted_pose_rel)
  	movel(lifted_pose, a=0.03, v=0.1)
  	CCW_Rotate()
  end
  
  
  # calculate center pose on top of the container using pose transformation
  def center_pose():
  	# pose transformation from side of the container to top to get center point
  	trans_rel = p[-0.005, 0.05, -0.027, 0, 0, 0]
  
  	p_translated = pose_trans(place_pose, trans_rel)
  	cx = p_translated[0]
  	cy = p_translated[1]
  	cz = p_translated[2]
  
  	global p_center_vertical = p[cx,cy,cz, 0, 0, 4.14]
  
  	#movej(p_center_vertical, a =0.3, v =0.3)
  	return p_center_vertical
  end
  
  # update center pose based on tilting
  def updated_center_pose(p_center_vertical, angle_deg):
  	hinge_pose = pose_trans(p_center_vertical, p[0,0,-0.2,0,0,0])
  	local_rel = pose_trans(pose_inv(hinge_pose), p_center_vertical)
  
  	rot_tilt = p[0,0,0, -deg2rad(angle_deg),0,0]
  	local_rel_tilted = pose_trans(rot_tilt, local_rel)
  
  	global p_center = pose_trans(hinge_pose, local_rel_tilted)
  	return p_center
  end
  
  #------
  # POTS commands
  def tilt_send(angle):
  	socket_open("192.168.12.101", 80)
  	angle = 92.0 - angle
  	socket_send_string("Tilt,"+to_str(angle)+",0")
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def Motors_off():
  	socket_open("192.168.12.101", 80)
  	socket_send_string("Off,0,0")
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def Rotate():
  	socket_open("192.168.12.101", 80)
  	socket_send_string("FullRotation, 1, 2000")
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  
  def CCW_Rotate():
  	socket_open("192.168.12.101", 80)
  	socket_send_string("FullRotation, -1, 2000")
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def tilt_to_home():
  	socket_open("192.168.12.101", 80)
  	socket_send_string("Home,0,0")
  	sync()
  	sleep(0.5)
  	socket_close()
  end
