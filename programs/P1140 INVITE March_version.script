  		#if (level>10.0 and diff>=3.5):
  			#target_g = 2.85
  		#elif (level>10.0 and diff<3.5):
  			#target_g = 0.8
  		#elif (level<=10.0 and level >1.0):
  			#target_g = 0.8
  		#else:
  			#target_g = 0.06
  		#end
  	#end
  
  	global spatula = select_spatula(Pow_name, level, diff)
  	global target_g = get_target_g(Pow_name, spatula)
  
  	global scoop_depth = compute_scoop_depth(level, weight_value, target_g)
  
  	tilt(level)
  	#p_center = get_actual_tcp_pose()
  
  	if (scoop_ct < 5 and g_prev_cum_w>0.0):
  		#local scoop_g = scoop_g
  		local error = target_g - scoop_g
  		error_sum = error_sum + error
  		error_sq_sum = error_sq_sum + error*error
  		scoop_ct = scoop_ct+1
  
  		if (scoop_ct==5):
  			local avg_error = error_sum/5.0
  			#local std_dev = sqrt(error_sq_sum/5.0) - (avg_error*avg_error))
  
  			if (my_abs(avg_error)>1.0):
  				g_k = 0.055
  				g_alpha = 0.85
  			elif (my_abs(avg_error)>0.6):
  				g_k= 0.045
  				g_alpha =0.75
  			elif (my_abs(avg_error)> 0.3):
  				g_k = 0.035
  				g_alpha = 0.65
  			elif (my_abs(avg_error)>0.1):
  				g_k = 0.025
  				g_alpha = 0.55
  			else:
  				g_k = 0.015
  				g_alpha = 0.45
  			end
  		end
  	end
  
  	scoop_powder(p_center)
  end
  
  
  def after_scoop():
  	tilt_send(angle_deg)
  	sleep(0.5)
  	movel(lifted_pose, a=0.05, v=0.2)
  	movel(tilted_pose_in_base, a=0.05, v=0.2)
  	set_analog_out(0,0.4)
  	movel(pose_trans(tilted_pose_in_base, p[-0.01,0,0,0,0,2.0]), a=0.05, v=0.2)
  	set_analog_out(0,0.0)
  	movel(lifted_pose, a=0.05, v=0.2)
  	tilt_to_home()
  end
  $ 24 "Script: dosing_pid.script"
  def dosing_pid(target_weight):
  	#kp = 0.005
  	#ki = 0.02
  	#kd = 0.2
  	#dt = 0.05
  	#current_error = 0.0
  	#Integral_error = 0.0
  	#previous_error = 0.0
  	#tilt_angle = -1.0
  	max_tilt_angle = -0.55
  	#current_pose = get_actual_tcp_pose()
  
  	while ( weight_value < target_weight and tilt_angle < max_tilt_angle):
  		weight_value = get_weight()
  		current_error = target_weight - weight_value
  		Integral_error = Integral_error + current_error*dt
  		derivative = (current_error - previous_error) / dt
  		tilt_increment = (kp * current_error) + (ki * Integral_error) + (kd * derivative)
  		current_pose = get_actual_tcp_pose()
  		tilt_angle = current_pose[4]
  		new_pose = pose_trans(current_pose, p[(tilt_increment/5), 0, 0, 0, tilt_increment, 0])
  		movel(new_pose, a = 0.075, v = 0.025, t = 0, r = 0)
  		previous_error = current_error
  		sleep(dt)
  	end
  end
