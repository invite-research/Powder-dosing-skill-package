  def get_weight():
  	socket_open("192.168.12.190", 3002)
  	sleep(0.2)
  	textmsg("socket opened successfully!")
  	socket_send_string("GET_WEIGHT")
  	sync()
  	sleep(0.5)
  	receiveFromServ = socket_read_ascii_float(6)
  	while (receiveFromServ[0] <1):
  		sleep(0.5)
  		receiveFromServ = socket_read_ascii_float(1)
  		textmsg("retrying read:", receiveFromServ)
  	end
  	textmsg("Received weight:", receiveFromServ[1])
  	socket_close()
  	sleep(0.2)
  	return receiveFromServ[1]
  end
  
