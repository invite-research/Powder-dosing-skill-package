    	#global s_depth = fl[1]
    	#global s_length = fl[2]
   	#global s_volume = fl[3]
   	#global ry_theta  = fl[4]
  	sleep(0.2)
  
  end
  
  def send_level_info():
  	socket_open(SERVER_IP,SERVER_PORT)
  	socket_send_string("SET_LEVEL:" + to_str(level))
  	sleep(0.2)
  	socket_close()
  end
  
  def send_weight_info():
    socket_open(SERVER_IP, SERVER_PORT)
    #rq_open_and_wait()
    cmd = "GET_CONT_WEIGHT"
    socket_send_string(cmd)
    sync()
    sleep(0.5)
    receiveFromSer = socket_read_ascii_float(1)
    socket_close()
    return receiveFromSer[1]
  end
  
