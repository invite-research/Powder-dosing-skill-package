def get_gripped_obj_number(min_prm_dst_1obj, min_prm_dst_2obj):
    Grip_Distan=rq_current_pos_mm()
    if (Grip_Distan>min_prm_dst_2obj):
        Obj_Gripped=2
    elif (Grip_Distan>min_prm_dst_1obj):
        Obj_Gripped=1
    else:
        Obj_Gripped=0 
    end
    return Obj_Gripped
end

