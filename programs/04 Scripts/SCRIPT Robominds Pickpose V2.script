def RobMinds_get_input(frame,dx = 0.02016, dy = 0.02):
  length1 = rb_get_attr_int("detections.length()")
  Pose_FRM_InputRack = p[0,0,0,0,0,0]
  Cam_Next_Pick = p[0,0,0,0,0,0]
  PickIdx=length1-1
cam_array=make_list(50,0,50)
	local Idx_X = 0
	local Idx_Y = 0
	local X_FRM_InputRack = 0
	local Y_FRM_InputRack = 0
  while PickIdx>=0:
              Cam_Next_Pick = rb_get_attr_pose("detections[" + to_str(PickIdx) + "].pose")
	global next_cap_col = rb_get_attr_string("detections[" + to_str(PickIdx) + "].name")
              if (next_cap_col != ""):
	      next_probe_height = Cam_Next_Pick[2]*1000 - 163+88-11
	     Pose_FRM_InputRack = pose_inv(pose_trans(pose_inv(Cam_Next_Pick), frame))
                    X_FRM_InputRack = Pose_FRM_InputRack[0] + dx/2 
                    Y_FRM_InputRack = Pose_FRM_InputRack[1] + dy/2
	    Idx_X = floor(norm(X_FRM_InputRack) / dx)
	    Idx_Y = floor(norm(Y_FRM_InputRack) / dy)
		textmsg("Idx_X ", Idx_X)
		textmsg("Idx_Y ", Idx_Y)
	     cam_array[Idx_X + 10*Idx_Y] = next_probe_height
              end
              PickIdx = PickIdx - 1
			  textmsg("PickIDX ", PickIdx)
  end 
return cam_array
end