global H          = 0
global H_c          = 0
global mouth_d     = 0
global mouth_sh    = 0
global length_c     = 0
global diameter   = 0
global empty_weight_g  = 0
global volume_ml    = 0
global shape_code   = 0
global flow_code   = 0
