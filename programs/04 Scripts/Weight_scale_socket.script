global weight = 0.0

thread weight_reader():
  socket_open("192.168.12.111", 3002)
  sleep(0.2)

  while True:
    if (Start_thread == True):

      socket_send_string("GET_WEIGHT")
      sync()
      sleep(0.2)

      data = socket_read_ascii_float(6)

      if (data[0] > 0):
        global weight_value = data[1]
      end

    end

    sleep(0.1)
  end
end

def get_weight():
  return weight
end

