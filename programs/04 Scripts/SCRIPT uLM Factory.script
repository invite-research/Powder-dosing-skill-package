def create_movement(id=0, actionlist=create_action_list([]), hh_approach=POS_Z, h_approach=POS_Z, approach=POS_Z, h_target=POS_Z, target=POS_Z, retract=POS_Z, h_retract=POS_Z, hh_retract=POS_Z, h_frame=POS_Z, frame=POS_Z, speed=1, acceleration=1, description="default"):
return struct(
    id = id,
    actionlist = actionlist,
    hh_approach = hh_approach,
    h_approach = h_approach,
    approach = approach, 
    h_target = h_target,
    target = target,
    retract = retract, 
    h_retract = h_retract,
    hh_retract = hh_retract,
    h_frame = h_frame,
    frame = frame, 
    speed = speed,
    acceleration = acceleration,
    description = description
)
end






