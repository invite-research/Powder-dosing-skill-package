current_state_log = ""
current_process_log = ""
current_step_log = ""
current_warning_log = ""
current_error_log = ""
current_hatch_log = ""
current_centrifuge_log = ""
current_message_log = "placeholderstring"
LogLevel=struct(NONE=0, INFO=1, PROCESS=2, WARNING=3, ERROR=4)
LOGLEVEL=LogLevel.INFO

def log_message(prefix="", newlog=current_message_log):
    # generates a log message every time its useful
    if (current_message_log != newlog and newlog != ""):
        textmsg(str_cat(prefix, to_str(newlog)))
        current_message_log = to_str(newlog)
    end
end

def log_state(newlog):
    # generates a log message every time its useful
    if (current_state_log != newlog and newlog != ""):
        textmsg(str_cat("Machine: ", to_str(newlog)))
        current_state_log = to_str(newlog)
    end
end

def log_process(newlog):
    # generates a log message every time its useful
    if (current_process_log != newlog and newlog != ""):
        textmsg(str_cat("Process: ", to_str(newlog)))
        current_process_log = to_str(newlog)
    end
end

def log_step(newlog):
    # generates a log message every time its useful
    if (current_step_log != newlog and newlog != ""):
        textmsg(str_cat("Step: ", to_str(newlog)))
        current_step_log = to_str(newlog)
    end
end

def log_info(newlog):
    # generates a log message if log level is Info or lower
    if (newlog != "" and LOGLEVEL <= LogLevel.INFO):
        textmsg(str_cat("INFO: ", newlog))
    end
end

def log_warning(newlog):
    # generates a log message every time its useful
    if (current_warning_log != newlog and newlog != ""):
        textmsg(str_cat("WARNING: ", to_str(newlog)))
        current_warning_log = to_str(newlog)
    end
end

def log_error(newlog):
    # generates a log message every time its useful
    if (current_error_log != newlog and newlog != ""):
        textmsg(str_cat("ERROR: ", to_str(newlog)))
        current_error_log = to_str(newlog)
    end
end

def log_hatch_state(newlog):
    # generates a log message every time its useful
    if (current_hatch_log != to_str(newlog) and to_str(newlog) != ""):
        textmsg(str_cat("Hatch_state: ", to_str(newlog)))
        current_hatch_log = to_str(newlog)
    end
end

def log_centrifuge_state(newlog):
    # generates a log message every time its useful
    if (current_centrifuge_log != to_str(newlog) and to_str(newlog) != ""):
        textmsg(str_cat("Centrifuge_state: ", to_str(newlog)))
        current_centrifuge_log = to_str(newlog)
    end
end