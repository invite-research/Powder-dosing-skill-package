global swab_poses=make_list(0,0,6)
global pose_list_hor=make_list(0,0,420)	
global pose_list_ver=make_list(0,0,420)
global cntd=False
global trgt_waypts=make_list(0,0,6)
global new_z=0
global first_pts=make_list(0,0,15)
global temp_pose_force=p[0,0,0,0,0,0]
global delta_rx=0
global new_dz=0
global server_msg=""
global delta_x=0
global delta_y=0


def connect2server():
	IP="192.168.12.139"
	port=3002
	while(cntd==False):
		cntd=socket_open(IP,port)
		if(cntd==True):
			textmsg("Connected to server")
		end
	end
	socket_send_string("SCAN_TARGET")
end


def get_hor_pose_from_server():
	
	IP="192.168.12.139"
	port=3002
	if(cntd==True):
		textmsg("Connected to server")
	end
	while(cntd==False):
		cntd=socket_open(IP,port)
		if(cntd==True):
			textmsg("Connected to server")
		end
		sleep(0.2)
	end
	socket_send_string("GET_POSE_HOR")
	idx=socket_read_ascii_float(1,timeout=-1)
	textmsg("Index from server=",idx[1])
	itn_i=0
	while(itn_i<idx[1]):
		msg=socket_read_ascii_float(6,timeout=-1)
		i=1
		while(i<7):
			swab_poses.append(msg[i])
			i=i+1
		end
		pose_list_hor.extend(swab_poses)
		swab_poses.clear()
		socket_send_string("OK")
		itn_i=itn_i+1
	end
	socket_read_line(timeout=-1)
	if(cntd==True):
		cntd=False
		socket_close()
	end
	#textmsg("server msg",swab_poses)
	textmsg("pose list",pose_list_hor)
end


