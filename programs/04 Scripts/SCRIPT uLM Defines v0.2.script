DEFAULT = struct(SPEED=0.8, ACCELERATION=0.6)

# ENUMS
Objects = struct(NONE=0, CC_SAMPLE=1, CC_RACK=2, COAG_SAMPLE=3, COAG_RACK=4, HEMA_SAMPLE=5, HEMA_RACK=6, INPUT_RACK=7, CF_RACK=8, ANY_SAMPLE=9, ANY_RACK=10, TARA_SAMPLE=11, BUTTON=12, XN550_DRAWER=13, COBAS_RACK=14)
