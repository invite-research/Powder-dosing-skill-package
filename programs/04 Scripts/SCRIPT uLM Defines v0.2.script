def find_object_by_objectname(objectname):
    local i = 0
    #log_info("Trying to find object by color:", to_str(objectname))
    while (i < OBJECT_MAP.length()):
        if (OBJECT_MAP[i].obj_name == objectname):
            log_info("Object Model found: [" + to_str(OBJECT_MAP[i].description) + "]")
            return OBJECT_MAP[i]
        end
        i = i + 1
    end
    log_warning("no Object Model found for objectname:[" + to_str(objectname) + "]")
    return create_object()
end

def find_smallest_object():
    local i = 0
    local min_size = OBJECT_MAP[0].height
    #log_info("Trying to find object by color:", to_str(objectname))
    while (i < OBJECT_MAP.length()):
        if (OBJECT_MAP[i].height <= min_size and OBJECT_MAP[i].height != 0):
            log_info("smaller object found: [" + to_str(OBJECT_MAP[i].description) + "]")
            min_size = OBJECT_MAP[i].height
        end
        i = i + 1
    end
    return min_size
end

def find_gripper_config_by_objectname(objectname):
local i = 0
while (i < GRIPPER_CONFIG_MAP.length()):
    #log_info("gripper config:",to_str(GRIPPER_CONFIG_MAP[i]))
    if (GRIPPER_CONFIG_MAP[i].object == objectname):
        log_info("found gripper parameters [" + to_str(GRIPPER_CONFIG_MAP[i]) + "]")
        return GRIPPER_CONFIG_MAP[i]
    end
    i = i + 1
end

log_warning("no gripper parameters found for object type: " + to_str(objectname))
return create_gripper_config()
end
# Function to find a landmark by item
def find_landmark_by_id(lm_id):
    local i = 0
    while i < LANDMARK_MAP.length():
        if LANDMARK_MAP[i].lm_id == lm_id:
            log_info("found landmark with id(" + to_str(lm_id) + "): [" + to_str(LANDMARK_MAP[i].description) + "]")
            return LANDMARK_MAP[i]
        end
        i = i + 1
    end
    log_warning("landmark not found for lm_id [" + to_str(lm_id) + "]")
    return create_landmark()
end
# Function to find a landmark by item
def find_landmark_by_capture_pos(capture_pos):
    local i = 0
    while i < LANDMARK_MAP.length():
        if LANDMARK_MAP[i].capture_pos == capture_pos:
            log_info("found landmark by capture_pos [" + to_str(LANDMARK_MAP[i].description) + "]")
            return LANDMARK_MAP[i]
        end
        i = i + 1
    end
    log_warning("Landmark not found for capture_pos: [" + to_str(capture_pos) + "]")
    return create_landmark()
end

def update_landmark_by_capture_pos(capture_pos, lm_pos):
    local i = 0
    while i < LANDMARK_MAP.length():
        if LANDMARK_MAP[i].capture_pos == capture_pos:
            log_info("updated landmark from [" + to_str(LANDMARK_MAP[i].description) + "]")
            LANDMARK_MAP[i].actual_frame = lm_pos
            return True
        end
        i = i + 1
    end
    log_warning("Landmark not found for capture_pos: [" + to_str(capture_pos) + "]")
    return False
end

def update_landmark_by_id(lm_id,lm_pos):
    local i = 0
    while i < LANDMARK_MAP.length():
        if LANDMARK_MAP[i].lm_id == lm_id:
            log_info("updated landmark.actual_frame from [" + to_str(LANDMARK_MAP[i].description + "]"))
            LANDMARK_MAP[i].actual_frame = lm_pos
            return True
        end
        i = i + 1
    end
    log_warning("Landmark not found for lm_id " + to_str(lm_id))
    return False
end

def find_vision_config_by_frame(frame):
    local i = 0
    while i < VISION_CONFIG_MAP.length():
        if VISION_CONFIG_MAP[i].capture_pos == frame:
            log_info("Vision Config found: [" + to_str(VISION_CONFIG_MAP[i].description) + "]")
            return VISION_CONFIG_MAP[i]
        end
        i = i + 1
    end
    log_info("Vision Config not found for frame: " + to_str(frame))
    return create_vision_config()
end

def find_vision_config_by_itemid(id):
    local i = 0
    while i < VISION_CONFIG_MAP.length():
        if VISION_CONFIG_MAP[i].item_id == id:
            log_info("Vision Config found: [" + to_str(VISION_CONFIG_MAP[i].description) + "]")
            return VISION_CONFIG_MAP[i]
        end
        i = i + 1
    end
    log_info("Vision Config not found for item: " + to_str(id))
    return create_vision_config()
end

def find_inspect_config_by_itemid(id):
    local i = 0
    while i < INSPECT_CONFIG_MAP.length():
        if INSPECT_CONFIG_MAP[i].item_id == id:
            log_info("Inspect Config found: [" + to_str(INSPECT_CONFIG_MAP[i].description) + "]")
            return INSPECT_CONFIG_MAP[i]
        end
        i = i + 1
    end
    log_info("Inspect Config not found for item: " + to_str(id))
    return create_inspect_config()
end
