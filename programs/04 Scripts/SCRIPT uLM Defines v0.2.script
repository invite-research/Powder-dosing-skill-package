ActionManipulator = struct(NONE=0, PICK=1, PLACE=2, DECAP=12, PUSH=3, RELEASE=21, GRASP=20, MOVE_TO=19, DRAWER_OPEN=51, DRAWER_CLOSE=52)
ActionAMR = struct(NONE=0, LOAD_MISSION=31, START_MISSION=32, NAVIGATE=33, ACKNOWLEDGE=34, READ=35)
ActionCamera = struct(NONE=0, INSPECT=16, DETECT=15, DETECT_OBJECTS=17)
Device = struct(MANIPULATOR=1, AMR=2, CAMERA=3)
Patterns = struct(NONE="NONE", TARA="TARA", CENTRIFUGE="CENTRIFUGE",CENTRIFUGE_MAGAZINE="CENTRIFUGE_MAGAZINE",SYSMEX_XN550="SYSMEX_XN550",COBAS="COBAS",COBAS_MAGAZINE="COBAS_MAGAZINE",INPUT="INPUT",NOK="NOK",DRAWER_XN550="DRAWER_XN550",ARCHIVE="ARCHIVE")
CommandStatus = struct(EXECUTED=0, UNFINISHED=1)

# Constants
MAX_CAPTURE_ATTEMPTS = 8
# Maximum Size of the Datastructures
MAX_ITEM_OBJ = 40
MAX_GRIPPER_OBJ = 10
MAX_LANDMARK_OBJ = 10
MAX_PATTERN_OBJ = 30
MAX_ITEM_MODEL_OBJ = 20
MAX_VISION_CONFIG_OBJ = 10
MAX_CAPTURE_RESULTS = 55
MAX_MOVEMENT_OBJ = 50

CON=False

# for Marburg Approach
LAST_CAPTURE = make_list(0, "", MAX_CAPTURE_RESULTS)

# Initialize the Datastructures in order to store related Data and use them in structs without length issues

OBJECT_MAP = make_list(0 ,create_object(), MAX_ITEM_OBJ)
ITEM_MAP = make_list(0, create_item(), MAX_ITEM_OBJ)
ITEM_MODEL_MAP = make_list(0, create_pattern(), MAX_ITEM_MODEL_OBJ)
GRIPPER_CONFIG_MAP = make_list(0, create_gripper_config(), MAX_PATTERN_OBJ)
VISION_CONFIG_MAP = make_list(0, create_vision_config(), MAX_VISION_CONFIG_OBJ)
INSPECT_CONFIG_MAP = make_list(0, create_inspect_config(), MAX_VISION_CONFIG_OBJ)
LANDMARK_MAP = make_list(0, create_landmark(), MAX_LANDMARK_OBJ)
MOVEMENT_MAP = make_list(0, create_movement(), MAX_MOVEMENT_OBJ)

OBJECT_REFERENCE_HEIGHT = 81


# functions to search in the datastructures which are defined in the factories

################# MOVEMENT ###############

def find_movement_by_frame_and_action(frame,action):
    local i = 0
    local ii = 0
    while (i < MOVEMENT_MAP.length()):
        if (MOVEMENT_MAP[i].frame == frame):
            while(ii < MOVEMENT_MAP[i].actionlist.length()):
                if (MOVEMENT_MAP[i].actionlist[ii] == action):
                    log_info("Movement found: [" + to_str(MOVEMENT_MAP[i].description) + "]")
                    return MOVEMENT_MAP[i]
                end
                ii = ii + 1
            end
            ii = 0
        end
        i = i + 1
    end
    log_warning("no movement found for frame: [" + to_str(frame) + "]")
    return create_movement(frame=frame)  # Return default pattern if not found
end

def find_item_by_lsitem_and_action(ls_item, action):
    local i = 0
    while (i < ITEM_MAP.length()):
        if (ITEM_MAP[i].ls_item == ls_item):
            local ii = 0
            while (ii < ITEM_MAP[i].actionlist.length()):
                if (ITEM_MAP[i].actionlist[ii] == action):
                    log_info("Item found: [" + to_str(ITEM_MAP[i].description) + "]")
                    return ITEM_MAP[i]
                end
                ii = ii + 1
            end
        end
        i = i + 1
    end
    log_warning("Item not found for station[" + to_str(ls_item) + "] and action[" + to_str(action) + "]")
    return create_item()  # Return default item if not found
end
################# PATTERN ###################

def find_pattern_by_name(name):
    local i = 0
    while (i < ITEM_MODEL_MAP.length()):
        if (ITEM_MODEL_MAP[i].name == name):
            log_info("Item Model found: [" + to_str(ITEM_MODEL_MAP[i].description) + "]")
            return ITEM_MODEL_MAP[i]
        end
        i = i + 1
    end
    log_warning("Item Model not found for name[" + to_str(name) + "]")
    return create_pattern()  # Return default pattern if not found
end

def is_in_list(list,val):
    local i = 0
    while(i<list.length()):
        if(list[i]==val):
            return True
        end
        i=i+1
    end
    return False
end 

def get_next_valid_patternslot(item_model, counter):
    local i = 0
    local temp = 0
    local max_slots = item_model.pattern_size[0] * item_model.pattern_size[1]
    log_info("blocked positions:" + to_str(item_model.blocked) + "| current pos: " + to_str(counter))
    while (i < item_model.blocked.length()):
        if(item_model.blocked[i] <= counter and item_model.blocked[i] != -1):
            temp = temp + 1
        end
        i = i + 1
    end

    if(is_in_list(item_model.blocked,counter+temp)):
        while(is_in_list(item_model.blocked,counter+temp)):
            temp=temp+1
        end
    end
    log_info("changed position in rack to nbr:" + to_str(counter+temp))

    return counter+temp

end

