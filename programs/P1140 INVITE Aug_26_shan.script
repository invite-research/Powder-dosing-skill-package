  ############# SCRIPT uLM Projectconfig ###############
  #*****************************************************
  # Customer          :   URG
  # Product Name      :   uLabMobile
  #****************************************************
  # Controller/Robot  :   UR5e
  # Software          :   5.17
  # Dependencies      :   Factory Script, Defines Script, relevant project knowledge about objects, patterns, items, commands, vision skills, landmarktypes and movements
  # How To            :   Define Step by Step all Project Data by creating the objects and appending them to the assigned List, if you skip information
  #                       the default value will be assigned -> give as many details as possible as the default values will not work in some cases
  #****************************************************
  # Author            :   D.Kreugel
  # Copyright (c)     :   United Robotics Group Health and Food GmbH
  #                       An der Riede 2
  #                       28816 Stuhr
  #                       Germany
  #****************************************************
  # Description       :   Project Related Configurations -> in the future will be configured by UGO
  # Version           :   0.2
  # Created           :   18.07.2024
  # Updated           :
  #****************************************************
  # Modifications     :
  # Date              :
  # Name              :
  # Reason            :
  #****************************************************
  # TO DO             :  Simplify Rack Assignment, create Enums for Choices that can be made and will be repeated in many projects, documentation
  
  #
  
  # Please Import DeviceScripts and Defines Script First as you may wanna use some of the Defined Variables here
  
  # Define here the Objects that should be handled, add a new Object Type in the defines if necessary
  # create_object(id=0, obj_name=0, height=0, width=0, color="default", material="default", description="default")
  # struct(NONE=0, CC_SAMPLE=1, CC_RACK=2, COAG_SAMPLE=3, COAG_RACK=4, HEMA_SAMPLE=5, HEMA_RACK=6, INPUT_RACK=7, CF_RACK=8, ANY_SAMPLE=9, ANY_RACK=10)
  #create_object(id=0, obj_name=0, height=0, width=0, obj_type = 0, description="default")
  OBJECT_MAP.append(create_object(id=0, obj_name=Objects.NONE, obj_type=ObjectType.NONE, height=0, width=0, description="None Object"))
  OBJECT_MAP.append(create_object(id=1, obj_name=Objects.CC_SAMPLE, obj_type=ObjectType.SAMPLE, height=108, width=15, description="BD Li-Heparin"))
  OBJECT_MAP.append(create_object(id=2, obj_name=Objects.HEMA_SAMPLE, obj_type=ObjectType.SAMPLE, height=81, width=13, description="BD EDTA"))
  OBJECT_MAP.append(create_object(id=3, obj_name=Objects.CC_SAMPLE, obj_type=ObjectType.SAMPLE, height=108, width=15, description="BD Li-Heparin"))
