  def get_cont_weight():
    socket_open(SERVER_IP, SERVER_PORT)
    #rq_open_and_wait()
    cmd = "GET_CONT_WEIGHT"
    socket_send_string(cmd)
    sync()
    sleep(0.5)
    receiveFromSer = socket_read_ascii_float(1)
    socket_close()
    return receiveFromSer[1]
  end
  
  $ 22 "Script: dosing_fumehood.script"
  def scoop_powder_fume(p_center):
  	set_tcp(tcp_dosing)
  	local scoop_radius = mouth_d / 2 - spatula_depth - wall_thickness
  	local total_depth = clamp(mouth_sh + spatula_mid, 0.001, H - spatula_mid)
  	local scoop_entry = pose_trans(p_center, p[-TCP_2_tip_x,0,spatula_len,0,0,0])
  	local scoop_safe_entry = pose_trans(p_center, p[-TCP_2_tip_x,0,spatula_len+0.05,0,0,0])
  	local scoop_start_rel = p[scoop_radius,0,-total_depth,0,0,0]
  	local scoop_start = pose_trans(scoop_entry, scoop_start_rel)
  	local scoop_via = pose_trans(scoop_entry, pose_trans(p[0,0,0,0,0,0.785], scoop_start_rel))
  	local scoop_end = pose_trans(scoop_entry, pose_trans(p[0,0,0,0,0,1.5708], scoop_start_rel))
  
  	movel(scoop_safe_entry, a=0.1, v=0.25)
  	movel(scoop_entry, a=0.1, v=0.25)
  	movel(scoop_start, a=0.1, v=0.25)
  	movec(scoop_via, scoop_end, a=0.05, v=0.04)
  
  	local pivot_pose = pose_trans(scoop_end, p[0,0,total_depth-spatula_len,0,0,0])
  	local end_rel = pose_trans(pose_inv(pivot_pose), scoop_end)
  	local safe_angle = asin((mouth_d-spatula_depth-wall_thickness)/total_depth)
  	local end_rel_tilted = pose_trans(end_rel, p[0,0,0,0,deg2rad(50)-safe_angle-deg2rad(spatula_ry),0])
  	local exit_pose = pose_trans(pivot_pose, p[0,0,0,end_rel_tilted[3],end_rel_tilted[4],end_rel_tilted[5]])
  	local exit_pose = pose_trans(exit_pose, p[0,0,spatula_len-total_depth,0,0,0])
  	movel(exit_pose, a=0.03, v=0.1)
  
  	if (scoop_status == "normal"):
  		vibration_3()
  	end
  	movel(p_center, a=0.1, v=0.25)
  	set_analog_out(0,0.0)
  	set_tcp(tcp_default)
  end
  
  def auto_scoop(W_now, target_weight, weight_value):
  	get_scoop_weight(spatula, bulk_density)
  	scoop_powder_fume(p_center)
  end
