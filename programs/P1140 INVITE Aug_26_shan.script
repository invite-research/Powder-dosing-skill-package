  #global SERVER_IP   = "192.168.12.139"
  
  
  global tcp_dosing = p[0,0,0.15052,3.1415,0,0]
  global tcp_default = p[0,0,0.161,3.1415,0,0]
  
  global container_id = 0
  global powder_id  = 0
  global bulk_density = 0
  global H          = 0
  global H_c          = 0
  global mouth_d     = 0
  global mouth_sh    = 0
  global length_c     = 0
  global diameter   = 0
  global empty_weight_g  = 0
  global volume_ml    = 0
  global shape_code   = 0
  global flow_code   = 0
  global shape = ""
  global Flowability = ""
  global full_weight_g = 0
  global cent_edge = 0
  global pick_2_base = 0.2 # distance from tcp to base of picking table
  global wall_thickness = 0.002
  
  def read_db_data():
  
    socket_open(SERVER_IP, SERVER_PORT)
    sleep(0.5)
    socket_send_string("GET_DATACODE_FLOATS")
    sleep(5)
  
    local fl = socket_read_ascii_float(14)
    socket_close()
  
    global container_id = fl[1]
    global powder_id = fl[2]
    global bulk_density = fl[3]
    global H          = fl[4]/1000
    global H_c          = fl[5]/1000
    global mouth_d     = fl[6]/1000
    global mouth_sh    = fl[7]/1000
    global length_c     = fl[8]/1000
    global diameter   = fl[9]/1000
    global empty_weight_g = fl[10]
    global volume_ml    = fl[11]
    global full_weight_g = fl[12]
    global flow_code   = fl[13]
    global shape_code   = fl[14]
  
  	if (flow_code == 1.0):
  		global Flowability = "MEDIUM"
  	elif (flow_code == 2.0):
  		global Flowability = "LOW"
  	else:
  		global Flowability = "HIGH"
  	end
  
  	if ( shape_code == 1.0):
  		shape = "cylindrical"
  		cent_edge =  diameter
  	else:
  		shape = "cubical"
  		cent_edge =  length_c
  	end
  
  	read_spatula_data()
  
  end
  
  def send_picking_info(Pow_name, target_weight):
    socket_open(SERVER_IP, SERVER_PORT)
    cmd = "PICK:"+Pow_name+";"+to_str(target_weight)
    socket_send_string(cmd)
    sleep(0.1)
    socket_close()
  end
  
  #### POTS ####
  def tilt_send(angle):
  	socket_open(SERVER_IP, SERVER_PORT)
  	angle = 92.0 - angle
  	socket_send_string("TILT:"+to_str(angle))
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def CW_Rotate(angle):
  	socket_open(SERVER_IP, SERVER_PORT)
  	socket_send_string("CWROTATE:"+to_str(angle))
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def CCW_Rotate(angle):
  	socket_open(SERVER_IP, SERVER_PORT)
  	socket_send_string("CCWROTATE:"+to_str(angle))
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def CW_full_Rotate():
  	socket_open(SERVER_IP, SERVER_PORT)
  	socket_send_string("FULLROTATE:"+to_str(1))
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def CCW_full_Rotate():
  	socket_open(SERVER_IP, SERVER_PORT)
  	socket_send_string("FULLROTATE:"+to_str(-1))
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  
  def tilt_to_home():
  	socket_open(SERVER_IP, SERVER_PORT)
  	socket_send_string("HOME")
  	sync()
  	sleep(0.5)
  	socket_close()
  end
  #######
  def vibration_1():
  	set_analog_out(0,0.4)
  	sleep(1)
  	set_analog_out(0,0.0)
  	sleep(0)
  end
  
  def vibration_2():
  	set_analog_out(0,0.4)
  	sleep(0.8)
  	set_analog_out(0,0.0)
  	sleep(0.2)
  end
  
  def vibration_3():
  	set_analog_out(0,0.4)
  	sleep(0.5)
  	set_analog_out(0,0.0)
  	sleep(0.3)
  end
  
  def vibration_4():
  	set_analog_out(0,0.4)
  	sleep(0.5)
  	set_analog_out(0, 0.0)
  	sleep(0.5)
  end
  
  def vibration_5():
  	set_analog_out(0,0.4)
  	sleep(0.2)
  	set_analog_out(0, 0.0)
  	sleep(0.8)
  end
  
