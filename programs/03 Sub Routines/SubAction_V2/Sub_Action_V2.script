  # end: URCap Installation Node
  global GRP_Close_Pos=100
  global GRP_Open_Pos=45
  global Timer_Barc_scan=0
  global Timer_Barc_scan_is_counting=False
  thread Timer_Thread():
    while (True):
      if (Timer_Barc_scan_is_counting):
        Timer_Barc_scan = Timer_Barc_scan + get_steptime()
      end
      sync()
    end
  end
  run Timer_Thread()
