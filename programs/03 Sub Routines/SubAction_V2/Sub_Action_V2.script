      local stepsToRetract=tool_contact(direction=targetTcpDirection)
      if (stepsToRetract > 0):
        kill move_thread_han_223
        stopl(3.0)
        local backTrackMovement=get_actual_joint_positions_history(stepsToRetract)
        local contactPose=get_forward_kin(backTrackMovement)
        local posDir=[targetTcpDirection[0],targetTcpDirection[1],targetTcpDirection[2]]
        local retractTo=contactPose
        if (norm(posDir) > 1e-6):
          local normalizedPosDir=normalize(posDir)
          local additionalRetraction=p[normalizedPosDir[0] * 0.0, normalizedPosDir[1] * 0.0, normalizedPosDir[2] * 0.0, 0, 0, 0]
          retractTo = pose_sub(contactPose, additionalRetraction)
        end
        movel(retractTo, a=3.0, v=0.1)
        $ 224 "Until (tool_contact_detection)"
        break
      end
      sleep(1.0E-10)
      if (move_thread_flag_223 > 1):
        join move_thread_han_223
        break
      end
      sync()
    end
    $ 225 "Set Open3FG=Off"
    set_standard_digital_out(4, False)
    $ 226 "Wait: 0.5"
    sleep(0.5)
  elif (5 == switch_1):
    $ 231 "Case 5"
    $ 248 "Decapping"
    $ 249 "Action_Info≔'decapping'"
    global Action_Info="decapping"
    $ 250 "Set EN_3FG=On"
    set_standard_digital_out(5, True)
    $ 251 "Set DecapTurn=On"
    set_standard_digital_out(3, True)
    $ 252 "action_manipulator_decapping()"
    action_manipulator_decapping()
    $ 253 "Set EN_3FG=Off"
    set_standard_digital_out(5, False)
    $ 254 "Set DecapTurn=Off"
    set_standard_digital_out(3, False)
    $ 255 "MoveL"
    $ 256 "PSE_R" "breakAfter"
    movel(pose_trans(FRM_Reference, PSE_R), a=0.8, v=0.15)
  elif (6 == switch_1):
    $ 257 "Case 6"
    $ 276 "Drop"
    $ 277 "rq_set_speed_norm(100)"
     rq_set_speed_norm (100)
    $ 278 "MoveJ"
    $ 279 "PSE_A" "breakAfter"
    movej(pose_trans(FRM_Reference, PSE_A), a=1.3962634015954636, v=1.7453292519943295, r=0.02)
    $ 280 "MoveL"
    $ 281 "PSE_T" "breakAfter"
    movel(pose_trans(FRM_Reference, PSE_T), a=0.08, v=0.12)
    # begin: URCap Program Node
    #   Source: Robotiq_Grippers, 3.11.2.92906, Robotiq Inc.
    #   Type: Gripper
    $ 282 "Gripper Move14mm (1)"
    if not(gripper_connected[0]):
      popup("Gripper 1 must be connected to run this program.", "No connection", False, True, True)
    end
    if not(rq_is_gripper_activated("1")):
      popup("Gripper 1 is not activated. Go to Installation tab > Gripper to activate it and run the program again.", "Not activated", False, True, True)
    end
    rq_set_pos_spd_for(153, 255, 77, "1")
    rq_wait_pos_spe_for_request(153, 255, 77, "1")
    rq_go_to("1")
    rq_wait("1")
    # end: URCap Program Node
    $ 283 "PSE_T_H" "breakAfter"
    movel(pose_trans(FRM_Reference, PSE_T_H), a=0.08, v=0.12)
    $ 284 "rq_move_and_wait_norm(GRP_Open_Pos)"
     rq_move_and_wait_norm (GRP_Open_Pos)
    $ 285 "Wait: 0.2"
    sleep(0.2)
    $ 286 "PSE_R" "breakAfter"
    movel(pose_trans(FRM_Reference, PSE_R), a=0.5, v=0.4)
  elif (7 == switch_1):
    $ 287 "Case 7"
    $ 288 "Load"
    $ 289 "Action_Info≔'load object in the machine'"
    global Action_Info="load object in the machine"
    $ 291 "If JNT_A≠[0,0,0,0,0,0]"
    if (JNT_A != [0,0,0,0,0,0]):
      $ 292 "MoveJ"
      $ 293 "JNT_A" "breakAfter"
      movej(JNT_A, a=1.3962634015954636, v=1.7453292519943295, r=0.02)
    else:
      $ 294 "Else" "noBreak"
      $ 295 "MoveJ"
      $ 296 "PSE_A" "breakAfter"
      movej(pose_trans(FRM_Reference, PSE_A), a=1.3962634015954636, v=1.7453292519943295, r=0.02)
    end
    $ 297 "MoveL"
    $ 302 "PSE_T_H" "breakAfter"
    movel(pose_trans(FRM_Reference, PSE_T_H), a=0.04, v=0.07)
    $ 303 "rq_move_and_wait_norm(GRP_Close_Pos)"
     rq_move_and_wait_norm (GRP_Close_Pos)
    $ 304 "Wait: 0.2"
    sleep(0.2)
    $ 305 "PSE_T" "breakAfter"
    movel(pose_trans(FRM_Reference, PSE_T), a=0.04, v=0.07)
    # begin: URCap Program Node
    #   Source: Robotiq_Grippers, 3.11.2.92906, Robotiq Inc.
    #   Type: Gripper
    $ 306 "Gripper Move18mm (1)"
    if not(gripper_connected[0]):
      popup("Gripper 1 must be connected to run this program.", "No connection", False, True, True)
    end
    if not(rq_is_gripper_activated("1")):
      popup("Gripper 1 is not activated. Go to Installation tab > Gripper to activate it and run the program again.", "Not activated", False, True, True)
    end
    rq_set_pos_spd_for(127, 0, 173, "1")
    rq_wait_pos_spe_for_request(127, 0, 173, "1")
    rq_go_to("1")
    rq_wait("1")
    # end: URCap Program Node
    $ 307 "PSE_R" "breakAfter"
    movel(pose_trans(FRM_Reference, PSE_R), a=0.5, v=0.4)
  elif (16 == switch_1):
    $ 308 "Case 16"
    $ 309 "Scan the barcode"
    $ 310 "Action_Info≔'scan the barcode'"
    global Action_Info="scan the barcode"
    $ 311 "Barc_scan_succs≔ False "
    global Barc_scan_succs=  False  
    $ 312 "First check"
    $ 313 "Set BarcodeTrigger=On"
    set_standard_digital_out(6, True)
    $ 314 "Wait: 0.1"
    sleep(0.1)
    $ 315 "Barc_scan_succs≔BarcodeSignal"
    global Barc_scan_succs=get_standard_digital_in(6)
    $ 316 "If Barc_scan_succs"
    if (Barc_scan_succs):
      $ 317 "Set EN_3FG=On"
      set_standard_digital_out(5, True)
      $ 318 "Set CapTurn=On"
      set_standard_digital_out(2, True)
      $ 319 "Loop Barc_scan_succs"
      thread Thread_while_319():
        while (True):
          $ 320 "Barc_scan_succs≔BarcodeSignal"
          global Barc_scan_succs=get_standard_digital_in(6)
          $ 321 "Wait: 0.05"
          sleep(0.05)
        end
      end
      if (Barc_scan_succs):
        global thread_handler_319=run Thread_while_319()
        while (Barc_scan_succs):
          sync()
        end
        kill thread_handler_319
      end
      $ 322 "Set EN_3FG=Off"
      set_standard_digital_out(5, False)
      $ 323 "Set CapTurn=Off"
      set_standard_digital_out(2, False)
      $ 324 "Set BarcodeTrigger=Off"
      set_standard_digital_out(6, False)
    else:
      $ 325 "Else" "noBreak"
      $ 326 "Timer_Barc_scan: Reset"
      Timer_Barc_scan = 0
      $ 327 "Timer_Barc_scan: Start"
      Timer_Barc_scan_is_counting = True
      $ 328 "Set DecapTurn=On"
      set_standard_digital_out(3, True)
      $ 329 "Set EN_3FG=On"
      set_standard_digital_out(5, True)
      $ 330 "Loop  not Barc_scan_succs and  not CMD_Stop and Timer_Barc_scan<60"
      thread Thread_while_330():
        while (True):
          $ 333 "Set BarcodeTrigger=On"
          set_standard_digital_out(6, True)
          $ 334 "Barc_scan_succs≔BarcodeSignal"
          global Barc_scan_succs=get_standard_digital_in(6)
          $ 335 "Wait: 0.05"
          sleep(0.05)
        end
      end
      if (  not  Barc_scan_succs  and    not  CMD_Stop  and  Timer_Barc_scan<60):
        global thread_handler_330=run Thread_while_330()
        while (  not  Barc_scan_succs  and    not  CMD_Stop  and  Timer_Barc_scan<60):
          sync()
        end
        kill thread_handler_330
      end
      $ 336 "Set EN_3FG=Off"
      set_standard_digital_out(5, False)
      $ 337 "Set DecapTurn=Off"
      set_standard_digital_out(3, False)
      $ 338 "Set BarcodeTrigger=Off"
      set_standard_digital_out(6, False)
      $ 339 "Timer_Barc_scan: Stop"
      Timer_Barc_scan_is_counting = False
      $ 340 "If Timer_Barc_scan≥60"
      if (Timer_Barc_scan >= 60):
        $ 341 "set_error(5200)"
        set_error(5200)
      end
    end
  end
  $ 342 "'=========='"
  # '=========='
  $ 343 "PostSettings"
  $ 344 "OBJ_Picked≔rq_is_object_detected()"
  global OBJ_Picked= rq_is_object_detected ()
  $ 345 "If OBJ_Picked"
  if (OBJ_Picked):
    $ 346 "rq_set_force_norm(50)"
     rq_set_force_norm (50)
  end
end
