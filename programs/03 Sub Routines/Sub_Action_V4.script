    end
    $ 280 "Search for code"
    $ 281 "Wait ( not Barcode_OK and  not Barcode_nOK and  not GRP_3F_Decap)"
    while (not((  not  get_standard_digital_in(6)  and    not  get_standard_digital_in(7)  and    not  get_standard_digital_out(3)))):
      sync()
    end
    $ 282 "TMR_Barcode: Start"
    TMR_Barcode_is_counting = True
    $ 283 "Set GRP_3F_Cap=On"
    set_standard_digital_out(2, True)
    $ 284 "Set BarcodeTrigger=On"
    set_standard_digital_out(6, True)
    $ 285 "Wait TMR_Barcode≥PRM_TO_Read_BC or Barcode_OK or Barcode_nOK"
    while (not(TMR_Barcode >= PRM_TO_Read_BC  or  get_standard_digital_in(6)  or  get_standard_digital_in(7))):
      sync()
    end
    $ 286 "Set GRP_3F_Cap=Off"
    set_standard_digital_out(2, False)
    $ 287 "Set BarcodeTrigger=Off"
    set_standard_digital_out(6, False)
    $ 288 "TMR_Barcode: Stop"
    TMR_Barcode_is_counting = False
    $ 289 "If Barcode_OK"
    if (get_standard_digital_in(6)):
      $ 290 "barcode found"
      $ 291 "'nothing'"
      # 'nothing'
    else:
      $ 292 "ElseIf Barcode_nOK or TMR_Barcode≥PRM_TO_Read_BC"
      if (get_standard_digital_in(7)  or  TMR_Barcode >= PRM_TO_Read_BC):
        $ 293 "exeption"
        $ 294 "error"
        $ 295 "set_error(6000)"
        set_error(6000)
      end
    end
  elif (15 == switch_1):
    $ 296 "Case 15"
    $ 297 "Detect"
    $ 298 "Action_Info≔'detect'"
    global Action_Info="detect"
  end
  $ 299 "'=========='"
  # '=========='
  $ 300 "PostSettings"
  $ 301 "'ADD ADDITIONAL CHECKS'"
  # 'ADD ADDITIONAL CHECKS'
end
