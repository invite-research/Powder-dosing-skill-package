  def create_object_2(id=0, name="", type=0, dimension=struct(length=0, width=0, height=0, diameter=0), gripper_offset=p[0,0,0,0,0,0]):
      return struct(id=id, name=name, type=type, dimension=dimension, gripper_offset=gripper_offset)
  end
  
  OBJ = create_object_2()
  OBJs = make_list(0, create_object_2(), 50)
  
  OBJs.append(create_object_2(id=1, name="rack centrifuge", type=1, dimension=struct(length=0, width=0, height=0.106, diameter=0.020), gripper_offset=p[0,0,0.095,0,0,2.356]))
