  def create_jig_2(id=0, name="", type=0, capacity=0, jig_offset=p[0,0,0,0,0,0]):
      # iformation about used jigs
      return struct(id=id, name=name, type=type, capacity=capacity, jig_offset=jig_offset)
  end
  
