  visor__objPos_3 = [ p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0] ]
  visor__objPos_4 = [ p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0] ]
  visor__objPos_5 = [ p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0] ]
  visor__objPos_6 = [ p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0] ]
  visor__objPos_7 = [ p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0] ]
  visor__objPos_8 = [ p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0], p[0,0,0,0,0,0] ]
  visor__easyPickNodeId = ""
  visor__easyPickDeviceId = 0
  
  #######################################
  # Public functions
  def visor_isSendReqOk(device_id):
    visor__checkDeviceId(device_id)
    return visor__varSendReqOk[device_id - 1]
  end
  
  def visor_isResponseOk(device_id):
    visor__checkDeviceId(device_id)
    return visor__varRespOk[device_id - 1]
  end
  
  def visor_getResponse(device_id):
    visor__checkDeviceId(device_id)
    return visor_xml_rpc_client.Update.getResponse(device_id - 1)
  end
  
  def visor_terminal(device_id, request, opt_timeout = 6000):
    visor__checkDeviceId(device_id)
    while (not visor__sendRequest(device_id - 1, opt_timeout, request)):
      if visor__popup("Send terminal request failed"):
        return None
      end
    end
  end
  
  def visor_changeJob(device_id, jobName, opt_timeout = 6000):
    visor__checkDeviceId(device_id)
    visor__sendReqWaitSuccess(device_id - 1, opt_timeout, "CJN1" + visor__valToStr(str_len(jobName), 3) + jobName, "Send change job request failed","Change job failed")
  end
  
  def visor_trigger(device_id, opt_timeout = 6000, opt_setup = "fix"):
    visor__checkDeviceId(device_id)
  
    # Reset variables
    visor__partsFound[device_id -1] = 0
  
    # Execute trigger
    if (opt_setup =="arm"):
      visor__sendReqWaitSuccess(device_id - 1, opt_timeout, "TRR100" + visor__poseToVisorStr(get_actual_tcp_pose()), "Send trigger failed","Trigger not successful")
    else:
      visor__sendReqWaitSuccess(device_id - 1, opt_timeout, "TRX00", "Send trigger failed","Trigger not successful")
    end
  
    # Parse trigger response
    if (not visor_xml_rpc_client.Update.parseTriggerResult(device_id - 1)):
      visor__logMsg("VISOR, unable to parse trigger result, maybe wrong format", True)
      visor__popup("Incorrect Trigger Response<br>Did you configure the telegram for the used detector in SensoConfig correctly?")
      halt
    end
    visor__partsFound[device_id - 1] = visor_xml_rpc_client.Update.getTriggerPartsFound(device_id - 1)
    local i = 0
    while (i < visor__partsFound[device_id - 1]):
      visor__setObjPos(device_id, visor_xml_rpc_client.Update.getTriggerObjPos(device_id - 1, i), i)
      i = i + 1
    end
  end
  
  def visor_partsFound(device_id):
    visor__checkDeviceId(device_id)
    return visor__partsFound[device_id - 1]
  end
  
  def visor_resetResult(device_id):
    visor__checkDeviceId(device_id)
    visor__partsFound[device_id -1] = 0
  end
  
  def visor_getObjPos(device_id, idx):
    visor__checkDeviceId(device_id)
    visor__checkResultIdx(idx)
    return visor__getObjPos(device_id, idx)
  end
  
  def visor_getPose2d(device_id, idx, opt_refPose=p[0,0,0,0,0,0]):
    visor__checkDeviceId(device_id)
    visor__checkResultIdx(idx)
    local objPos = visor__getObjPos(device_id, idx)
    local refPose = pose_trans(opt_refPose, p[0,0,0,0,0,d2r(objPos[5])])
    return p[objPos[0] / 1000, objPos[1] / 1000, refPose[2], refPose[3], refPose[4], refPose[5]]
  end
  
  def visor_getPose3d(device_id, idx):
    visor__checkDeviceId(device_id)
    visor__checkResultIdx(idx)
    local objPos = visor__getObjPos(device_id, idx)
    local angles = rpy2rotvec([d2r(objPos[3]), d2r(objPos[4]), d2r(objPos[5])])
    return p[objPos[0] / 1000, objPos[1] / 1000, objPos[2] / 1000, angles[0], angles[1], angles[2]]
  end
  
  def visor_getAdditionalData(device_id, opt_idx=999):
    visor__checkDeviceId(device_id)
    return visor_xml_rpc_client.Update.getTriggerAdditionalData(device_id - 1, opt_idx)
  end
  
  def visor_getCalibSetImgPose(setNo):
    return visor_xml_rpc_client.Update.getCalibSetImagePose(setNo)
  end
  
  def visor_easyPickUpdate(device_id, param, value):
    visor__checkDeviceId(device_id)
    return visor_xml_rpc_client.Update.setEasyPickUpdate(device_id - 1, param, to_str(value))
  end
  
  def visor_activateOffset(device_id, detector_no, offset_mode, opt_timeout = 6000):
    visor__checkDeviceId(device_id)
  
    # Check detector number
    if (detector_no < 0) or (detector_no > 999):
      visor__logMsg("VISOR, invalid detector no: " + to_str(detector_no), True)
      visor__popup("Invalid detector no")
      halt
    end
  
    # Check offset_mode
    if (offset_mode != 0) and (offset_mode != 3):
      visor__logMsg("VISOR, invalid offset mode: " + to_str(offset_mode), True)
      visor__popup("Invalid offset mode")
      halt
    end
  
    # Send request
    local spp_request = "SPP" + visor__valToStr(detector_no, 3) + "030" + "00001" + to_str(offset_mode)
    visor__sendReqWaitSuccess(device_id - 1, opt_timeout, spp_request, "Activate offset failed", "Activate offset failed")
  
    return visor__varRespOk[device_id - 1]
  end
  
  def visor_teachOffset(device_id, detector_no, offset_pose, opt_timeout = 6000):
    visor__checkDeviceId(device_id)
  
    # Check detector number
    if (detector_no < 0) or (detector_no > 999):
      visor__logMsg("VISOR, invalid detector no: " + to_str(detector_no), True)
      visor__popup("Invalid detector nr")
      halt
    end
  
    # Send request
    local spp_request = "SPP" + visor__valToStr(detector_no, 3) + "035" + "00048" + visor__poseToVisorStr(offset_pose)
    visor__sendReqWaitSuccess(device_id - 1, opt_timeout, spp_request, "Teach offset failed", "Teach offset failed")
  
    return visor__varRespOk[device_id - 1]
  end
  
  def visor_calcCenter3d(device_id, visor1_pose, visor2_pose, opt_timeout = 6000):
  	visor__checkDeviceId(device_id)
  
  	local rf_mf_pose = p[0,0,0,0,0,0]
  	local mid_pose = p[0,0,0,0,0,0]
  
  	# get rm_mf
  	visor__sendReqWaitSuccess(device_id - 1, opt_timeout, "CGP1015", "Calculate center 3D not successful" , "Calculate center 3D not successful")
      local response = visor_xml_rpc_client.Update.getResponse(device_id - 1)
      if (visor__varSendReqOk[device_id - 1] and visor__varRespOk[device_id - 1]):
        local loopIdx = 0
        while (loopIdx < 6):
          rf_mf_pose[loopIdx] = to_num(str_sub(response,18+(loopIdx*8),8))/1000
          if (loopIdx > 2) and (loopIdx < 6):
            rf_mf_pose[loopIdx] = d2r(rf_mf_pose[loopIdx])
          end
          loopIdx = loopIdx + 1
        end
      end
      local axis_angle = rpy2rotvec([(rf_mf_pose[3]),(rf_mf_pose[4]),(rf_mf_pose[5])])
  	rf_mf_pose[3] = axis_angle[0]
  	rf_mf_pose[4] = axis_angle[1]
  	rf_mf_pose[5] = axis_angle[2]
  
  	# invert rf_mf_pose
      local rm_mf_pose_inverse = pose_inv(rf_mf_pose)
  
      # transform visor poses to measurement frame
      local visor1_pose_trans = pose_trans(rm_mf_pose_inverse, visor1_pose)
      local visor2_pose_trans = pose_trans(rm_mf_pose_inverse, visor2_pose)
  
      # calculate angle in measurement frame
      local dx = (visor2_pose_trans[0]-visor1_pose_trans[0])
      local dy = (visor2_pose_trans[1]-visor1_pose_trans[1])
      mid_pose[5] = atan(dy/dx)
      axis_angle = rpy2rotvec([(mid_pose[3]),(mid_pose[4]),(mid_pose[5])])
      mid_pose[3] = axis_angle[0]
  	mid_pose[4] = axis_angle[1]
  	mid_pose[5] = axis_angle[2]
  
      # transform back to robot frame
      mid_pose = pose_trans(rf_mf_pose, mid_pose)
  
      # center of x, y, z
      mid_pose[0] = (visor1_pose[0]+visor2_pose[0])/2
      mid_pose[1] = (visor1_pose[1]+visor2_pose[1])/2
      mid_pose[2] = (visor1_pose[2]+visor2_pose[2])/2
  
  	return mid_pose
  end
  
  def visor_easyPickCheckIdent(node_id, device_id):
    return (visor__easyPickNodeId == node_id) and (visor__easyPickDeviceId == device_id)
  end
  
  def visor_easyPickSetIdent(node_id, device_id):
    visor__easyPickNodeId = node_id
    visor__easyPickDeviceId = device_id
  end
  
  #######################################
  # Private functions
  def visor__checkDeviceId(device_id):
    if (device_id < 1) or (device_id > 8):
      visor__logMsg("VISOR, invalid device id: " + to_str(device_id), True)
      visor__popup("Invalid device id")
      halt
    end
  end
  
  def visor__checkResultIdx(idx):
    if (idx < 0) or (idx > 9):
      visor__logMsg("VISOR, invalid result index: " + to_str(idx), True)
      visor__popup("Invalid result index")
      halt
    end
  end
  
  def visor__logMsg(message, important=False):
    if (visor__debugLvl == 2) or important:
      textmsg(message)
    end
  end
  
  def visor__popup(message, warn=False, err=True):
    if visor__errInterrupt:
      popup(message, title="VISOR", warning=warn, error=err, blocking=True)
    end
    return (not visor__errInterrupt)
  end
  
  def visor__sendReqWaitSuccess(device_id, timeout, request, msgSendErr, msgRespErr):
    while True:
      if visor__sendRequest(device_id, timeout, request):
        if visor__varRespOk[device_id]:
          return None
        else:
          if visor__popup(msgRespErr, True, False):
            return None
          end
        end
      else:
        if visor__popup(msgSendErr):
          return None
        end
      end
    end
  end
  
  def visor__sendRequest(device_id, timeout, request):
    visor__logMsg("VISOR, send_request: " + request)
    visor__varSendReqOk[device_id] = visor_xml_rpc_client.Update.sendRequest(device_id, timeout, request)
    visor__varRespOk[device_id] = visor_xml_rpc_client.Update.isResponseOk(device_id)
    local response = visor_xml_rpc_client.Update.getResponse(device_id)
    visor__logMsg("VISOR, response: " + response)
    return visor__varSendReqOk[device_id]
  end
  
  def visor__valToStr(val, digits=0):
    local s = to_str(val)
    local delta = digits - str_len(s)
    local negative = False
    if (str_at(s, 0) == "-"):
      negative = True
      s = str_sub(s, 1)
    end
    while (delta > 0):
      s = "0" + s
      delta = delta -1
    end
    if negative:
      s = "-" + s
    end
    return s
  end
  
  def visor__setObjPos(device_id, pose, idx):
    if (device_id == 1):
      visor__objPos_1[idx] = pose
    elif (device_id == 2):
      visor__objPos_2[idx] = pose
    elif (device_id == 3):
      visor__objPos_3[idx] = pose
    elif (device_id == 4):
      visor__objPos_4[idx] = pose
    elif (device_id == 5):
      visor__objPos_5[idx] = pose
    elif (device_id == 6):
      visor__objPos_6[idx] = pose
    elif (device_id == 7):
      visor__objPos_7[idx] = pose
    elif (device_id == 8):
      visor__objPos_8[idx] = pose
    end
  end
  
  def visor__getObjPos(device_id, idx):
    if (device_id == 1):
      return visor__objPos_1[idx]
    elif (device_id == 2):
      return visor__objPos_2[idx]
    elif (device_id == 3):
      return visor__objPos_3[idx]
    elif (device_id == 4):
      return visor__objPos_4[idx]
    elif (device_id == 5):
      return visor__objPos_5[idx]
    elif (device_id == 6):
      return visor__objPos_6[idx]
    elif (device_id == 7):
      return visor__objPos_7[idx]
    elif (device_id == 8):
      return visor__objPos_8[idx]
    end
  end
  
  def visor__poseToVisorStr(tcpPose, useAxisAngle=False):
    # Convert to RPY, default VISOR configuration
    local rpy = rotvec2rpy([tcpPose[3], tcpPose[4], tcpPose[5]])
  
    poseStr = ""
    i = 0
    while (i < 6):
      if (i > 2):
        # Rotation, use RPY or axis angle and multiply by 1000
        if (not useAxisAngle):
          tcpPose[i] = r2d(rpy[i-3])
        end
        tcpPose[i] = floor(tcpPose[i] * 1000)
      else:
        # Location, convert to [mm] and multiply by 1000
        tcpPose[i] = floor(tcpPose[i] * 1000000)
      end
      # Convert value to valid format (prefixing with '0')
      # and add to pose string
      poseStr = poseStr + visor__valToStr(tcpPose[i], 8)
      i = i + 1
    end
    return poseStr
  end
