  $ 20 "Script: krish.script"
  def dynamic_upward_motion(distance,duration):
  	speed=distance/duration
  	speed_vector = [0, 0, speed, 0, 0, 0]
  	time_elapsed = 0
  	time_step = 1
  	while time_elapsed < duration:
  		speedl(speed_vector, 0.1, time_step)
  		sleep(time_step)
  		time_elapsed = time_elapsed + time_step
  	end
  	stopl(0.5)
  end
  dynamic_upward_motion(distance, duration)
  
  def vibration_1():
  	set_analog_out(0,0.4)
  	sleep(0.30)
  	set_analog_out(0,0.0)
  	sleep(0.50)
  end
  
  def vibration_2():
  	set_analog_out(0,0.4)
  	sleep(0.30)
  	set_analog_out(0,0.0)
  	sleep(0.50)
  end
  
  def vibration_3():
  	set_analog_out(0,0.4)
  	sleep(0.20)
  	set_analog_out(0,0.0)
  	sleep(0.70)
  end
  $ 21 "Script: Weight_scale_socket.script"
  def get_weight():
  	socket_open("192.168.12.190", 3002)
  	textmsg("socket opened successfully!")
  	socket_send_string("GET_WEIGHT")
  	sync()
  	sleep(0.5)
  	receiveFromServ = socket_read_ascii_float(6)
  	while (receiveFromServ[0] <1):
  		sleep(0.5)
  		receiveFromServ = socket_read_ascii_float(1)
  		textmsg("retrying read:", receiveFromServ)
  	end
  	textmsg("Received weight:", receiveFromServ[1])
  	socket_close()
  	return receiveFromServ[1]
  end
  
  def tare_scale():
  	socket_open("192.168.12.190", 3002)
  	socket_send_string("TARE")
  	sleep(0.5)
  	socket_close()
  end
  
  def zero_scale():
  	socket_open("192.168.12.190", 3002)
  	socket_send_string("ZERO")
  	sleep(0.5)
  	socket_close()
  end
