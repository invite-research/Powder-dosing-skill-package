      $ 646 "TM_St_Aborted≔get_time(STATE_Times[STATE-1])"
      global TM_St_Aborted=get_time(STATE_Times[STATE-1])
    elif (17 == switch_1):
      $ 647 "Case 17"
      $ 648 "TM_St_Clearing≔get_time(STATE_Times[STATE-1])"
      global TM_St_Clearing=get_time(STATE_Times[STATE-1])
    end
    $ 650 "Wait: 0.1"
    sleep(0.1)
  end
end
