  def move_tilt_in_steps(PowA_center, final_pose, steps):
  	i = 0
  	while i <= steps:
  		ratio = i / steps
  		pose_step = p[PowA_center[0] + ratio * (final_pose[0] - PowA_center[0]), PowA_center[1] + ratio * (final_pose[1] -PowA_center[1]),PowA_center[2] + ratio * (final_pose[2] - PowA_center[2]), PowA_center[3] + ratio * (final_pose[3] - PowA_center[3]), PowA_center[4] + ratio * (final_pose[4] - PowA_center[4]), PowA_center[5] + ratio * (final_pose[5] - PowA_center[5])]
  		movej(pose_step, a=1.2, v=0.15)
  		sleep(0.1)
  		i = i+1
  	end
  end
  
  def tilt_container(angle):
  	P_center = get_actual_tcp_pose()
  	hinge_offset = p[0,0,-0.23,0,0,0]
  	pivot_pose = pose_trans(P_center, hinge_offset)
  	pose_rel = pose_trans(pose_inv(pivot_pose), P_center)
  	angle_mid = (angle/2.0)*3.1416/180
  	angle_end = angle*3.1416/180
  	tilt_mid = p[0,0,0, -angle_mid, 0, 0]
  	tilt_end = p[0,0,0, -angle_end, 0, 0]
  	pose_rel_mid = pose_trans(tilt_mid, pose_rel)
  	pose_rel_end = pose_trans(tilt_end, pose_rel)
  	via_pose = pose_trans(pivot_pose, pose_rel_mid)
  	end_pose = pose_trans(pivot_pose, pose_rel_end)
  	movec(via_pose, end_pose, a=0.05, v=0.01, r=0.001)
  	P_center = get_actual_tcp_pose()
  end
  
  def scoop_powder(P_center):
  	#scoop_via_offset = p[0.05, 0.025, -0.03,0,0,0]
  	#scoop_end_offset = p[0.10, 0.05, -0.06, 0, 0,0]
  
  	#scoop_via_pose = pose_trans(scoop_start_pose, scoop_via_offset)
  	#scoop_end_pose = pose_trans(scoop_start_pose, scoop_end_offset)
  
  	#movel(scoop_start_pose, a=0.3, v=0.1)
  
  	#movec(scoop_via_pose, scoop_end_pose, a=0.3, v=0.1)
  
  	approach_offset = p[0.03,0,0.10,0,0,0]
  	scoop_radius = 0.03
  	#scoop_center = p[0, -0.01, 0.02, 0, 0, 1.5708]
  	tilt_down = p[0, 0, 0, -0.2618, 0, 0]
  	#scoop_out = p[0,0,0.10, 0, -0.2618,1.5708]
  	lift_offset = p[0, 0, 0.10, 0, 0, 0]
  	vibration_voltage = 4.0
  	vibration_time = 4.0
  
  	scoop_entry_pose = pose_trans(P_center, approach_offset)
  	movel(scoop_entry_pose, a=0.05, v=0.05)
  
  	scoop_start_rel = p[scoop_radius, 0, 0.02, 0, 0, 0]
  
  	rot_mid = p[0, 0, 0, 0, 0, 0.785]
  	rot_end = p[0, 0, 0, 0, 0, 1.5708]
  
  	scoop_via_rel = pose_trans(rot_mid, scoop_start_rel)
  	scoop_end_rel = pose_trans(rot_end, scoop_start_rel)
  
  	scoop_start_pose = pose_trans(P_center, scoop_start_rel)
  	scoop_via_pose = pose_trans(P_center, scoop_via_rel)
  	scoop_end_pose = pose_trans(P_center, scoop_end_rel)
  
  	movel(scoop_start_pose, a=0.03, v=0.05)
  
  	movec(scoop_via_pose, scoop_end_pose, a=0.03, v=0.05)
  
  	#scoop_center_pose = pose_trans(P_center, scoop_center)
  	#movel(scoop_center_pose, a=0.03, v=0.05)
  
  	tilted_pose = pose_trans(tilt_down, pose_trans(pose_inv(P_center), scoop_end_pose))
  	tilted_pose_in_base = pose_trans(P_center, tilted_pose)
  
  	movel(tilted_pose_in_base, a=0.03, v=0.05)
  
  	set_analog_out(0, vibration_voltage)
  	sleep(vibration_time)
  	set_analog_out(0, 0.0)
  
  	#scoop_out_pose = pose_trans(P_center, scoop_out)
  	#movel(scoop_out_pose, a=0.03, v=0.05)
  
  	tilt_pose_rel = pose_trans(pose_inv(P_center), tilted_pose_in_base)
  
  	lifted_pose_rel = pose_trans(lift_offset, tilt_pose_rel)
  
  	lifted_pose = pose_trans(P_center, lifted_pose_rel)
  	movel(lifted_pose, a=0.03, v=0.05)
  end
  $ 21 "Script: Weight_scale_socket.script"
  def get_weight():
  	socket_open("192.168.12.190", 3002)
  	textmsg("socket opened successfully!")
  	socket_send_string("GET_WEIGHT")
  	sync()
  	sleep(0.5)
  	receiveFromServ = socket_read_ascii_float(6)
  	while (receiveFromServ[0] <1):
  		sleep(0.5)
  		receiveFromServ = socket_read_ascii_float(1)
  		textmsg("retrying read:", receiveFromServ)
  	end
  	textmsg("Received weight:", receiveFromServ[1])
  	socket_close()
  	return receiveFromServ[1]
  end
  
  def tare_scale():
  	socket_open("192.168.12.190", 3002)
  	socket_send_string("TARE")
  	sleep(0.5)
  	socket_close()
  end
  
  def zero_scale():
  	socket_open("192.168.12.190", 3002)
  	socket_send_string("ZERO")
  	sleep(0.5)
  	socket_close()
  end
