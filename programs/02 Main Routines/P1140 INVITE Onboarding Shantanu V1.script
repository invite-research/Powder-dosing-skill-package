  # available rpc-functions:
  #.on('con_check', (err, _params, callback) => callback(err, this.con_check()))
  #.on('read_input', (err, params, callback) => callback(err, this.read_input(params[0], params[1])))
  #.on('write_output', (err, params, callback) => callback(err, this.write_output(params[0], params[1], params[2])))
  #.on('read_status', (err, params, callback) => callback(err, this.read_status(params[0])))
  #.on('write_status', (err, params, callback) => callback(err, this.write_status(params[0], params[1])))
  #.on('send_template', (err, params, callback) => callback(err, this.receive_state(params[0])))
  #.on('receive_event', (err, params, callback) => callback(err, this.send_event()))
  #.on('send_state', (err, params, callback) => callback(err, this.receive_state(params[0])))
  #.on('send_error', (err, params, callback) => callback(err, this.receive_error(params[0])))
  #.on('NotFound', (methodCalled, params) => LOG.warn('Method "', methodCalled, '" does not exist. ', { params }));
  
  # =======================================================================
  local IDX_CMD_STOP = 0
  local IDX_CMD_RESET = 1
  local IDX_CMD_START = 2
  local IDX_CMD_HOLD = 3
  local IDX_CMD_UNHOLD = 4
  local IDX_CMD_SUSPEND = 5
  local IDX_CMD_UNSUSPEND = 6
  local IDX_CMD_ABORT = 7
  local IDX_CMD_CLEAR = 8
  local IDX_FNC_FREEDRIVE = 9
  
  # uGo specific declarations
  global UGO_Request_ID = ""
  global UGO_UNIT_Task = ""
  global UGO_Task_ID = 0
  global UGO_Event = ""
  local UGO_Enable_Control = False
  local UGO = rpc_factory("xmlrpc", "http://192.168.12.120:8080")
  local UGO_Ctrl_Cmd = [False, False, False, False, False, False, False, False, False, False]
  
  local UGO_AMR_Pos = struct(position_identifier=0, x1=0, x2=0, y1=0, y2=0, theta1=0, theta2=0)
  local UGO_EOAT = struct(object_picked=False)
  
  def ugo_init(enable=True, rpc_address="http://192.168.12.120:8080"):
      # connection with uGo
      if enable:
          UGO = rpc_factory("xmlrpc", rpc_address)
          UGO_Enable_Control = True
      else:
          UGO_Enable_Control = False
      end
  end
  
  def ugo_event_controller():
      # interpret the given command and map it to the internal commands
      if UGO_Enable_Control:
          UGO_Event = UGO.receive_event()
      end
  
      UGO_Ctrl_Cmd[IDX_CMD_STOP] = (UGO_Event == "stop")
      UGO_Ctrl_Cmd[IDX_CMD_RESET] = (UGO_Event == "reset")
      UGO_Ctrl_Cmd[IDX_CMD_START] = (UGO_Event == "start")
      UGO_Ctrl_Cmd[IDX_CMD_HOLD] = (UGO_Event == "hold")
      UGO_Ctrl_Cmd[IDX_CMD_UNHOLD] = (UGO_Event == "un_hold")
      UGO_Ctrl_Cmd[IDX_CMD_SUSPEND] = (UGO_Event == "suspend")
      UGO_Ctrl_Cmd[IDX_CMD_UNSUSPEND] = (UGO_Event == "un_suspend")
      UGO_Ctrl_Cmd[IDX_CMD_ABORT] = (UGO_Event == "abort")
      UGO_Ctrl_Cmd[IDX_CMD_CLEAR] = (UGO_Event == "clear")
      UGO_Ctrl_Cmd[IDX_FNC_FREEDRIVE] = (UGO_Event == "freedrive")
  
      return UGO_Ctrl_Cmd
  end
  
  def ugo_translate_pml_state():
      # translate the current PML State to a string
      if (STATE == 1):
          return "STOPPING"
      elif (STATE == 2):
          return "STOPPED"
      elif (STATE == 3):
          return "RESETTING"
      elif (STATE == 4):
          return "IDLE"
      elif (STATE == 5):
          return "STARTING"
      elif (STATE == 6):
          return "EXECUTE"
      elif (STATE == 7):
          return "COMPLETING"
      elif (STATE == 8):
          return "COMPLETE"
      elif (STATE == 9):
          return "HOLDING"
      elif (STATE == 10):
          return "HELD"
      elif (STATE == 11):
          return "UNHOLDING"
      elif (STATE == 12):
          return "SUSPENDING"
      elif (STATE == 13):
          return "SUSPENDED"
      elif (STATE == 14):
          return "UNSUSPENDING"
      elif (STATE == 15):
          return "ABORTING"
      elif (STATE == 16):
          return "ABORTED"
      elif (STATE == 17):
          return "CLEARING"
      else:
          return "UNKNOWN"
      end
  end
  
  def ugo_update_outputs():
      #Update the outputs to uGo via xmplrpc service
      UGO.write_status("ROB_Skill", UGO_UNIT_Task)
      UGO.write_status("ROB_Battery", AMR_Battery)
      UGO.write_status("ROB_Gripper", OBJ_Picked)
      UGO.send_state(ugo_translate_pml_state(), UGO_UNIT_Task)
      UGO.send_error(ERROR.ID)
      #UGO.send_position(AMR_Position)
  end
  
  def ugo_get_task():
      # get the actual task to work on
      # added: reflecting the UID of the task back to uGO
      UGO_UNIT_Task = UGO.read_status("DSH_Workflow")
      if (UGO_UNIT_Task != ""):
          UGO_Request_ID = str_sub(UGO_UNIT_Task, 0, 39)
          UGO_Task_ID = to_num(str_sub(UGO_UNIT_Task, 40, 2))
          #ugo_tasks()
          return UGO_Task_ID
      else:
          return 0
      end
  end
  
  def ugo_pml_stopping():
      return True
  end
  
  def ugo_pml_resetting():
      ugo_get_task()
      if (UGO_UNIT_Task == ""):
          UGO_Request_ID = ""
          UGO_Task_ID = 0
          return True
      end
      return False
  end
  
  def ugo_pml_starting():
      #UGO_Task_Content = UGO.receive_task()
      return (UGO_UNIT_Task != "")
  end
  
  def ugo_pml_holding():
      return True
  end
  
  def ugo_pml_unholding():
      return True
  end
  
  def ugo_pml_suspending():
      return True
  end
  
  def ugo_pml_unsuspending():
      return True
  end
  
  def ugo_pml_completing():
      return True
  end
  
  def ugo_pml_aborting():
      return True
  end
  
  def ugo_pml_clearing():
      return True
  end
  
  # =======================================================================
  # end of uGO script
  # =======================================================================
  $ 7 "Script: SCRIPT PackML V1.2.1.script"
  # PackML
  
  IO_ADDRESS_CMD_STOP = 1
  IO_ADDRESS_CMD_RESET = 7
  IO_ADDRESS_CMD_START = 0
  
  EXT_ADDRESS_CMD_STOP = 0
  EXT_ADDRESS_CMD_RESET = 1
  EXT_ADDRESS_CMD_START = 2
  EXT_ADDRESS_CMD_HOLD = 3
  EXT_ADDRESS_CMD_UNHOLD = 4
  EXT_ADDRESS_CMD_SUSPEND = 5
  EXT_ADDRESS_CMD_UNSUSPEND = 6
  EXT_ADDRESS_CMD_ABORT = 7
  EXT_ADDRESS_CMD_CLEAR = 8
  EXT_ADDRESS_FNC_FREEDRIVE = 9
  
  global EXT_CtrlCmd = [False, False, False, False, False, False, False, False, False, False]
  
  EXT_Control_by = "uGO"
  
  global CMD_Abort = False
  global CMD_Clear = False
  global CMD_Stop = False
  global CMD_Reset = False
  global CMD_Start = False
  global CMD_Hold = False
  global CMD_Unhold = False
  global CMD_Suspend = False
  global CMD_Unsuspend = False
  global FNC_Freedrive = False
  
  CND_Suspend = False         # condition for suspend command
  CND_Unsuspend = False       # condition for unsuspend command
  
  thread Get_Pml_Command():
      while (True):
          if (EXT_Control_by == "uGO"):
              EXT_CtrlCmd = ugo_event_controller()
          elif (EXT_Control_by == "Leitsystem"):
              # EXT_CtrlCmd = Leitsystem
          end
          # ---------- Abort ---------- #
          if ((not STATE == 15) and (not STATE == 16) and EXT_CtrlCmd[EXT_ADDRESS_CMD_ABORT]):
              CMD_Abort = True
              CMD_Stop = False
          elif ((STATE == 17) and not EXT_CtrlCmd[EXT_ADDRESS_CMD_ABORT]):
              CMD_Abort = False
          end
          # ---------- Stop ---------- #
          if ((not STATE == 1) and (not STATE == 2) and (get_standard_digital_in(IO_ADDRESS_CMD_STOP) or EXT_CtrlCmd[EXT_ADDRESS_CMD_STOP])):
              CMD_Stop = True
              if get_standard_digital_in(IO_ADDRESS_CMD_STOP):
                  log_state("Stop command by pushbutton")
              elif EXT_CtrlCmd[EXT_ADDRESS_CMD_STOP]:
                  log_state("Stop command by external control")
              end
          elif (STATE == 2) and (not get_standard_digital_in(IO_ADDRESS_CMD_STOP)) and (not EXT_CtrlCmd[EXT_ADDRESS_CMD_STOP]):
              CMD_Stop = False
          end
          CMD_Hold = (STATE == 6 or STATE == 10) and not CMD_Stop and (ERROR.FLAG or EXT_CtrlCmd[EXT_ADDRESS_CMD_HOLD])
          CMD_Reset = (STATE == 2 or STATE == 8) and not CMD_Stop and (read_input_boolean_register(5) or EXT_CtrlCmd[EXT_ADDRESS_CMD_RESET])
          CMD_Start = (STATE == 4) and not CMD_Stop and (get_standard_digital_in(IO_ADDRESS_CMD_START) or EXT_CtrlCmd[EXT_ADDRESS_CMD_START])
          CMD_Unhold = (STATE == 10) and not CMD_Stop and (get_standard_digital_in(IO_ADDRESS_CMD_START) or EXT_CtrlCmd[EXT_ADDRESS_CMD_UNHOLD])
          CMD_Suspend = (STATE == 6) and not CMD_Stop and (CND_Suspend or EXT_CtrlCmd[EXT_ADDRESS_CMD_SUSPEND])
          CMD_Unsuspend = (STATE == 13) and not CMD_Stop and (CND_Unsuspend or EXT_CtrlCmd[EXT_ADDRESS_CMD_UNSUSPEND])
          CMD_Clear = (STATE == 16) and EXT_CtrlCmd[EXT_ADDRESS_CMD_CLEAR]
          FNC_Freedrive = (STATE == 10) and EXT_CtrlCmd[EXT_ADDRESS_FNC_FREEDRIVE]
          sleep(0.1)
      end
  end
  
  thread_pml_command_handler = run Get_Pml_Command()
  
  def command_manager(external_control="uGO", cond_suspend=False, cond_unsuspend=False):
  
      EXT_Control_by = external_control
      CND_Suspend = cond_suspend
      CND_Unsuspend = cond_unsuspend
  
      if (CMD_Abort and STATE != 15 and STATE != 16):
          STATE = 15
      elif (CMD_Stop and STATE != 1 and STATE != 2):
          STATE = 1
      end
      return False
  end
  
  def stopping():
      if (EXT_Control_by == "uGO"):
          return ugo_pml_stopping()
      elif (EXT_Control_by == "Leitsystem"):
          # EXT_CtrlCmd = Leitsystem
      else:
          return True
      end
      return False
  end
  
